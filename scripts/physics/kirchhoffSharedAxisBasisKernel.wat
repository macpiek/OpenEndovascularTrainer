(module
 (import "env" "memory" (memory 1))
 ;; The same integer min-heap as the JS sparse pivot queue.
 (func $push (param $heap i32) (param $queued i32) (param $pivot i32) (param $stamp i32) (param $count i32) (result i32)
  (local $at i32) (local $parent i32) (local $value i32)
  (if (i32.lt_s (local.get $pivot) (i32.const 0)) (then (return (local.get $count))))
  (local.set $at (i32.add (local.get $queued) (i32.mul (local.get $pivot) (i32.const 4))))
  (if (i32.eq (i32.load (local.get $at)) (local.get $stamp)) (then (return (local.get $count))))
  (i32.store (local.get $at) (local.get $stamp))
  (local.set $at (local.get $count))
  (block $done (loop $up
   (br_if $done (i32.eqz (local.get $at)))
   (local.set $parent (i32.shr_u (i32.sub (local.get $at) (i32.const 1)) (i32.const 1)))
   (local.set $value (i32.load (i32.add (local.get $heap) (i32.mul (local.get $parent) (i32.const 4)))))
   (br_if $done (i32.le_s (local.get $value) (local.get $pivot)))
   (i32.store (i32.add (local.get $heap) (i32.mul (local.get $at) (i32.const 4))) (local.get $value))
   (local.set $at (local.get $parent)) (br $up)))
  (i32.store (i32.add (local.get $heap) (i32.mul (local.get $at) (i32.const 4))) (local.get $pivot))
  (i32.add (local.get $count) (i32.const 1)))
 (func $pop (param $heap i32) (param $count i32) (result i32)
  (local $result i32) (local $last i32) (local $at i32) (local $child i32) (local $value i32)
  (local.set $result (i32.load (local.get $heap)))
  (local.set $count (i32.sub (local.get $count) (i32.const 1)))
  (local.set $last (i32.load (i32.add (local.get $heap) (i32.mul (local.get $count) (i32.const 4)))))
  (if (local.get $count) (then
   (block $done (loop $down
    (local.set $child (i32.add (i32.mul (local.get $at) (i32.const 2)) (i32.const 1)))
    (br_if $done (i32.ge_s (local.get $child) (local.get $count)))
    (if (i32.lt_s (i32.add (local.get $child) (i32.const 1)) (local.get $count)) (then
     (if (i32.lt_s
       (i32.load (i32.add (local.get $heap) (i32.mul (i32.add (local.get $child) (i32.const 1)) (i32.const 4))))
       (i32.load (i32.add (local.get $heap) (i32.mul (local.get $child) (i32.const 4)))))
      (then (local.set $child (i32.add (local.get $child) (i32.const 1)))))))
    (local.set $value (i32.load (i32.add (local.get $heap) (i32.mul (local.get $child) (i32.const 4)))))
    (br_if $done (i32.ge_s (local.get $value) (local.get $last)))
    (i32.store (i32.add (local.get $heap) (i32.mul (local.get $at) (i32.const 4))) (local.get $value))
    (local.set $at (local.get $child)) (br $down)))
   (i32.store (i32.add (local.get $heap) (i32.mul (local.get $at) (i32.const 4))) (local.get $last))))
  (local.get $result))
 (func (export "eliminate")
  (param $vectors i32) (param $supports i32) (param $lengths i32) (param $pivots i32)
  (param $v i32) (param $support i32) (param $pivotAt i32) (param $marks i32)
  (param $queued i32) (param $heap i32) (param $eliminations i32) (param $factors i32) (param $result i32)
  (param $stride i32) (param $basisCount i32) (param $supportCount i32) (param $stamp i32)
  (local $sparse i32) (local $heapCount i32) (local $scan i32) (local $qi i32) (local $pivot i32)
  (local $qv i32) (local $qs i32) (local $qlen i32) (local $k i32) (local $j i32) (local $at i32) (local $eliminationCount i32)
  (local $projection f64) (local $value f64)
  (local.set $sparse (i32.gt_s (local.get $basisCount) (i32.const 64)))
  (block $initDone (loop $init
   (br_if $initDone (i32.ge_s (local.get $k) (local.get $supportCount)))
   (local.set $j (i32.load (i32.add (local.get $support) (i32.mul (local.get $k) (i32.const 4)))))
   (i32.store (i32.add (local.get $marks) (i32.mul (local.get $j) (i32.const 4))) (local.get $stamp))
   (if (i32.and (local.get $sparse) (f64.ne (f64.load (i32.add (local.get $v) (i32.mul (local.get $j) (i32.const 8)))) (f64.const 0)))
    (then (local.set $heapCount (call $push (local.get $heap) (local.get $queued)
     (i32.load (i32.add (local.get $pivotAt) (i32.mul (local.get $j) (i32.const 4)))) (local.get $stamp) (local.get $heapCount)))))
   (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $init)))
  (block $done (loop $next
   (if (local.get $sparse) (then
    (br_if $done (i32.eqz (local.get $heapCount)))
    (local.set $qi (call $pop (local.get $heap) (local.get $heapCount)))
    (local.set $heapCount (i32.sub (local.get $heapCount) (i32.const 1))))
    (else
     (br_if $done (i32.ge_s (local.get $scan) (local.get $basisCount)))
     (local.set $qi (local.get $scan)) (local.set $scan (i32.add (local.get $scan) (i32.const 1)))))
   (local.set $pivot (i32.load (i32.add (local.get $pivots) (i32.mul (local.get $qi) (i32.const 4)))))
   (local.set $projection (f64.load (i32.add (local.get $v) (i32.mul (local.get $pivot) (i32.const 8)))))
   (br_if $next (f64.eq (local.get $projection) (f64.const 0)))
   (local.set $qv (i32.add (local.get $vectors) (i32.mul (i32.mul (local.get $qi) (local.get $stride)) (i32.const 8))))
   (local.set $qs (i32.add (local.get $supports) (i32.mul (i32.mul (local.get $qi) (local.get $stride)) (i32.const 4))))
   (local.set $qlen (i32.load (i32.add (local.get $lengths) (i32.mul (local.get $qi) (i32.const 4)))))
   (local.set $k (i32.const 0))
   (block $rowDone (loop $row
    (br_if $rowDone (i32.ge_s (local.get $k) (local.get $qlen)))
    (local.set $j (i32.load (i32.add (local.get $qs) (i32.mul (local.get $k) (i32.const 4)))))
    (local.set $at (i32.add (local.get $v) (i32.mul (local.get $j) (i32.const 8))))
    (local.set $value (f64.sub (f64.load (local.get $at)) (f64.mul (local.get $projection)
     (f64.load (i32.add (local.get $qv) (i32.mul (local.get $j) (i32.const 8)))))))
    (f64.store (local.get $at) (local.get $value))
    (if (f64.ne (local.get $value) (f64.const 0)) (then
     (local.set $at (i32.add (local.get $marks) (i32.mul (local.get $j) (i32.const 4))))
     (if (i32.ne (i32.load (local.get $at)) (local.get $stamp)) (then
      (i32.store (local.get $at) (local.get $stamp))
      (i32.store (i32.add (local.get $support) (i32.mul (local.get $supportCount) (i32.const 4))) (local.get $j))
      (local.set $supportCount (i32.add (local.get $supportCount) (i32.const 1)))))
     (if (local.get $sparse) (then
      (local.set $at (i32.load (i32.add (local.get $pivotAt) (i32.mul (local.get $j) (i32.const 4)))))
      (if (i32.gt_s (local.get $at) (local.get $qi)) (then
       (local.set $heapCount (call $push (local.get $heap) (local.get $queued) (local.get $at) (local.get $stamp) (local.get $heapCount)))))))))
    (local.set $k (i32.add (local.get $k) (i32.const 1))) (br $row)))
   (f64.store (i32.add (local.get $v) (i32.mul (local.get $pivot) (i32.const 8))) (f64.const 0))
   (i32.store (i32.add (local.get $eliminations) (i32.mul (local.get $eliminationCount) (i32.const 4))) (local.get $qi))
   (f64.store (i32.add (local.get $factors) (i32.mul (local.get $eliminationCount) (i32.const 8))) (local.get $projection))
   (local.set $eliminationCount (i32.add (local.get $eliminationCount) (i32.const 1))) (br $next)))
  (i32.store (local.get $result) (local.get $supportCount))
  (i32.store (i32.add (local.get $result) (i32.const 4)) (local.get $eliminationCount))))
