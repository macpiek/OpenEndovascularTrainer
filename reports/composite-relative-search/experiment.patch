+import {advanceCompositeJointTimeStep as advance,createCompositeJointTimeStepWorkspace as workspace} from '../src/physics/kirchhoffCompositeJointTimeStep.js';
+
+const close=(a,b,t=1e-8)=>assert.ok(Number.isFinite(a)&&Number.isFinite(b)&&Math.abs(a-b)<=t,`${a} != ${b}`);
+const vector=(a,b,t)=>{assert.equal(a.length,b.length);a.forEach((v,i)=>close(v,b[i],t));};
+const accepted=r=>assert.equal(r.accepted,true,JSON.stringify({status:r.status,error:r.error,diagnostics:r.diagnostics}));
+function parity(a,b) {
+    accepted(a);accepted(b);
+    for(const [id,p] of a.state.toolPositions)p.forEach((v,i)=>vector(v,b.state.toolPositions.get(id)[i],2e-9));
+    for(const [id,v] of a.state.angles)vector(v,b.state.angles.get(id),2e-9);
+    vector(a.state.lengthMultipliers,b.state.lengthMultipliers,1e-8);
+    for(const key of ['lumenContactState','lumenFrictionState'])if(a.state[key]) {
+        const field=key==='lumenContactState'?'normalForces':'tractions';vector(a.state[key][field],b.state[key][field],1e-8);
+    }
+    for(const r of [a,b]) {
+        assert.equal(r.diagnostics.certificate.converged,true);
+        for(const [id,p] of r.state.toolPositions)for(let e=0;e<p.length-1;e++)
+            close(Math.hypot(...p[e+1].map((v,k)=>v-p[e][k])),r.state.restLengths.get(id)[e],1e-8);
