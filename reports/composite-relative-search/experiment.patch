+import {createCoulombBandLU} from './kirchhoffCoulombBandLU.js';
+
+/** A principal search subspace, never a physical constraint or certificate.
+ * Omitted increments are zero for this attempt only. Its caller must measure
+ * EVERY original equation and enrich the subspace before accepting a direction.
+ * Ordered restriction preserves the original local band and dual asymmetry.
+ * Only structure/storage is cached; numeric matrix/RHS/scales are recopied.
+ */
+export function createCompositeRestrictedDirectionCache(capacity=2) {
+    if(!Number.isInteger(capacity)||capacity<1||capacity>4)throw new RangeError('Restricted direction cache capacity must be 1..4');
+    return {capacity,entries:new Map(),builds:0,hits:0};
+}
+
+export function solveCompositeRestrictedDirection(cache,{layout,keep,matrix,residual,scales,correction}) {
+    const count=keep.length;
+    if(layout.starts.length!==count||matrix.length!==layout.entries||[residual,scales,correction].some(a=>a.length!==count)||
+        !keep.every(v=>v===0||v===1))throw new RangeError('Restricted search arrays must match the original band');
+    const indices=Int32Array.from(Array.from(keep,(v,i)=>v?i:-1).filter(i=>i>=0));
+    if(!indices.length)throw new RangeError('The search subspace must retain an equation');
+    const signature=JSON.stringify([Array.from(layout.starts),Array.from(layout.ends),Array.from(indices)]);
+    let w=cache.entries.get(signature);
+    if(w){cache.hits++;cache.entries.delete(signature);}
+    else {
+        const inverse=new Int32Array(count).fill(-1);indices.forEach((d,i)=>inverse[d]=i);
+        const n=indices.length,starts=new Int32Array(n),ends=new Int32Array(n),offsets=new Int32Array(n),source=[];
+        let entries=0,kl=0,ku=0;
+        indices.forEach((d,i)=>{
+            let first=i,last=i;
+            for(let j=layout.starts[d];j<=layout.ends[d];j++)if(inverse[j]>=0){first=Math.min(first,inverse[j]);last=Math.max(last,inverse[j]);}
+            starts[i]=first;ends[i]=last;offsets[i]=entries-first;
+            for(let j=first;j<=last;j++)source.push(layout.offsets[d]+indices[j]);
+            entries+=last-first+1;kl=Math.max(kl,i-first);ku=Math.max(ku,last-i);
+        });
+        const packed={starts,ends,offsets,entries,kl,ku};
+        w={indices,source:Int32Array.from(source),matrix:new Float64Array(entries),residual:new Float64Array(n),scales:new Float64Array(n),
+            correction:new Float64Array(n),layout:packed,lu:createCoulombBandLU(packed,n)};
+        cache.builds++;
+    }
+    cache.entries.set(signature,w);if(cache.entries.size>cache.capacity)cache.entries.delete(cache.entries.keys().next().value);
+    w.source.forEach((s,i)=>w.matrix[i]=matrix[s]);
+    w.indices.forEach((d,i)=>{w.residual[i]=residual[d];w.scales[i]=scales[d];});
+    const accepted=w.lu.solve(w.matrix,w.residual,w.scales,0,w.correction);
+    correction.fill(0);if(accepted)w.indices.forEach((d,i)=>correction[d]=w.correction[i]);
