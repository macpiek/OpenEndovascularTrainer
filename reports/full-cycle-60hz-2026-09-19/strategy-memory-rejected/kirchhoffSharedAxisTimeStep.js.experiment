    if(options.velocityPredictor) {
        const increment=new Float64Array(s.layout.dofCount),decay=.98**(dt*120);
        for(let n=0;n<s.positions.length;n++)for(let a=0;a<3;a++) {
            const dof=s.layout.positions[n]+a;
