/** Live load coupling is a faster direction strategy for the same wall law.
 * If its nonsymmetric active set fails, the attempt above has already restored
 * the original physical state/history. Retry the complete dt with frozen-load
 * outer corrections, retaining only discovered static geometry. Cancellation
 * cannot enter this fallback: generator.return unwinds the attempt's finally. */
export function* iterateSharedAxisTimeStep(s,dt,options={}) {
    // Research-only ordering hint from an accepted preceding step. The hinted
    // attempt is private and rolls back before the original full strategy on
    // failure. It never changes the physical tolerances or accepted-step gate.
    if(options.preferredSolveStrategy) {
        const {preferredSolveStrategy,...ordinary}=options;
        const attempted=yield* iterateSharedAxisTimeStep(s,dt,{...ordinary,...preferredSolveStrategy,
            predictorFallback:false,coupledFrictionFallback:false,wallNormalFallback:false});
        if(attempted.converged)return {...attempted,preferredStrategyAttempts:1,preferredStrategyFailures:0};
        const reference=yield* iterateSharedAxisTimeStep(s,dt,ordinary);
        const result={...reference,preferredStrategyAttempts:1,preferredStrategyFailures:1,
            preferredStrategyFailure:attempted.status};
        for(const key of ['predictorFallbacks','wallNormalFallbacks','retainedDiscoveryTrials','coupledFrictionRefreshes','coupledFrictionFallbacks','iterations','factorizations','workingSetReuses','backtracks','geometryRestarts','frictionIterations','fullAssemblies','residualAssemblies','promotedAssemblies','modifiedAttempts','modifiedAccepted','modifiedFallbacks','ms'])
            result[key]=(attempted[key]??0)+(reference[key]??0);
        result.timings=Object.fromEntries(Object.keys(reference.timings).map(key=>[key,(attempted.timings[key]??0)+reference.timings[key]]));
        return result;
    }
    const predictor=options.velocityPredictor??0;
    if(!Number.isFinite(predictor)||predictor<0||predictor>1)throw new RangeError('Velocity predictor must be between zero and one');
    if(options.velocityPredictor&&options.predictorFallback!==false) {
        // A poor prediction is only a failed initial guess. The attempt's
        // finally restores pose, rates and history before an ordinary retry.
        const attempt=yield* iterateSharedAxisTimeStep(s,dt,{...options,predictorFallback:false});
        if(attempt.converged||!attempt.predictedInitialPose)return attempt;
        const reference=yield* iterateSharedAxisTimeStep(s,dt,{...options,velocityPredictor:0});
        const out={...reference,predictorFallbacks:1+(attempt.predictorFallbacks??0)+(reference.predictorFallbacks??0),predictorRecovery:{attempted:true,predictorStatus:attempt.status,converged:reference.converged}};
        for(const key of ['wallNormalFallbacks','retainedDiscoveryTrials','coupledFrictionRefreshes','coupledFrictionFallbacks','iterations','factorizations','workingSetReuses','backtracks','geometryRestarts','frictionIterations','fullAssemblies','residualAssemblies','promotedAssemblies','modifiedAttempts','modifiedAccepted','modifiedFallbacks','ms'])
            out[key]=(attempt[key]??0)+(reference[key]??0);
        out.timings=Object.fromEntries(Object.keys(reference.timings).map(key=>[key,(attempt.timings[key]??0)+reference.timings[key]]));
        return out;
    }
    if(options.coupledFrictionNewton&&options.coupledFrictionFallback!==false) {
        // A private attempt. Any failure/cancellation restores the incoming
        // pose and friction history before the original strategy is retried.
        let experiment=yield* iterateSharedAxisTimeStep(s,dt,{...options,coupledFrictionFallback:false,wallNormalFallback:false});
        // Repeating the identical initial outside-surface check cannot repair
