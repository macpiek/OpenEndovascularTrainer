@@ -0,0 +1,29 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createSharedAxisLinear,solveSharedAxisLinear} from '../src/physics/kirchhoffSharedAxisLinear.js';
+
+test('dependent wall normals remain independent through the regularized dual equations',()=>{
+    for(const compactWorkingSet of [false,true])for(const reuseMatrixAssembly of [false,true]) {
+        const layout={dofCount:1,band:1},chain={layout,hessian:Float64Array.of(1)},c=1e-8;
+        const rows=[0,1].map(i=>({id:`wall-${i}`,kind:'wall',dofs:[0],jacobian:[1],gap:0,multiplier:0}));
+        const r=solveSharedAxisLinear(createSharedAxisLinear(layout,rows,{lazy:true}),chain,
+            {rows,gradient:Float64Array.of(1),fixed:new Uint8Array(1),contactDualRegularization:c,
+                compactWorkingSet,reuseMatrixAssembly,tolerance:1e-10});
+        assert.ok(r.converged,JSON.stringify(r));
+        const x=r.increment[0],lambda=Array.from(r.multiplierIncrement);
+        assert.ok(lambda.every(v=>v>0));
+        assert.ok(Math.abs(x-lambda[0]-lambda[1]+1)<1e-10);
+        for(const v of lambda)assert.ok(Math.abs(x+c*v)<1e-10);
+        assert.ok(Math.abs(x)<c);
+    }
+});
+
+test('inactive gaps use the same proximal equation as active gaps, including old reactions',()=>{
+    const layout={dofCount:1,band:1},chain={layout,hessian:Float64Array.of(1)},c=.1;
+    const rows=[{kind:'wall',dofs:[0],jacobian:[1],gap:10,multiplier:3}];
+    const r=solveSharedAxisLinear(createSharedAxisLinear(layout,rows,{lazy:true}),chain,
+        {rows,gradient:Float64Array.of(0),fixed:new Uint8Array(1),contactDualRegularization:c,tolerance:1e-10});
+    assert.ok(r.converged);assert.equal(r.multiplierIncrement[0],-3);
+    assert.ok(Math.abs(r.increment[0]-r.multiplierIncrement[0])<1e-10);
+    assert.ok(rows[0].gap+r.increment[0]+c*r.multiplierIncrement[0]>0);
+});
