+import {Box3,Line3,Ray,Vector3} from 'three';
+
+/** Clearance of the whole replacement capsule, used only to veto a merge.
+ * This is not an inside/outside classifier or a physical contact equation.
+ * Ordinary complete discovery and acceptance still validate the new state. */
+export function createSharedAxisChordGuard(field,sheathLength){
+    const segment=new Line3(),box=new Box3(),ray=new Ray(),hit=new Vector3();
+    const stats={queries:0,blocked:0,triangleTests:0};
+    const guard=({a,b,coordinateA,coordinateB,origin=[0,0,0],radius})=>{
+        if(coordinateB<=sheathLength)return true;
+        stats.queries++;
+        const tree=field.fallbackGeometry?.boundsTree;
+        if(!tree||!(radius>0)||!Number.isFinite(radius)){stats.blocked++;return false;}
+        const start=Math.max(0,(sheathLength-coordinateA)/(coordinateB-coordinateA));
+        for(let k=0;k<3;k++){
+            segment.start.setComponent(k,(1-start)*a[k]+start*b[k]+origin[k]);
+            segment.end.setComponent(k,b[k]+origin[k]);
+        }
+        const lengthSquared=segment.start.distanceToSquared(segment.end);
+        if(!(lengthSquared>0)){stats.blocked++;return false;}
+        box.makeEmpty().expandByPoint(segment.start).expandByPoint(segment.end).expandByScalar(radius);
+        ray.origin.copy(segment.start);ray.direction.subVectors(segment.end,segment.start).normalize();
+        const blocked=tree.shapecast({
+            intersectsBounds:bounds=>bounds.intersectsBox(box),
+            intersectsTriangle:triangle=>{
+                stats.triangleTests++;
+                // closestPointToSegment checks edges/endpoints; explicitly
+                // catch crossing the interior of a finite triangle as well.
+                if(ray.intersectTriangle(triangle.a,triangle.b,triangle.c,false,hit)&&hit.distanceToSquared(segment.start)<=lengthSquared)return true;
+                const distance=triangle.closestPointToSegment(segment);
+                return !Number.isFinite(distance)||distance<radius-1e-6;
+            }
+        });
+        if(blocked)stats.blocked++;return !blocked;
+    };
+    guard.stats=stats;return guard;
+}
