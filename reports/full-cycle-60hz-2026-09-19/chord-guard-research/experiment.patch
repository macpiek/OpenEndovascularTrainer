+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {BufferGeometry,Float32BufferAttribute} from 'three';
+import {MeshBVH} from 'three-mesh-bvh';
+import {createSharedAxisChordGuard} from '../src/physics/kirchhoffSharedAxisChordGuard.js';
+import {coarsenSharedAxisMesh} from '../src/physics/kirchhoffSharedAxisAdaptiveMesh.js';
+
+function plane(y=0,x=10){
+    const geometry=new BufferGeometry();geometry.setAttribute('position',new Float32BufferAttribute([
+        -x,y,-10,x,y,-10,x,y,10,-x,y,-10,x,y,10,-x,y,10],3));
+    geometry.boundsTree=new MeshBVH(geometry);return geometry;
+}
+test('whole-chord clearance rejects interior triangle crossings and radius overlaps',()=>{
+    const geometry=plane(),guard=createSharedAxisChordGuard({fallbackGeometry:geometry},0);
+    const check=(a,b,radius=.4,origin=[0,0,0])=>guard({a,b,radius,origin,coordinateA:1,coordinateB:3});
+    assert.equal(check([-1,1,0],[1,1,0]),true);
+    assert.equal(check([-1,.3,0],[1,.3,0]),false);
+    assert.equal(check([0,-1,0],[0,1,0],.01),false,'Endpoint/edge distances alone miss an interior crossing');
+    assert.equal(check([-1,0,0],[1,0,0],.4,[0,1,0]),true);
+    assert.equal(check([-1,0,0],[1,0,0],.4,[0,.3,0]),false);
+    assert.equal(guard({a:[0,-1,0],b:[0,1,0],radius:.4,coordinateA:-2,coordinateB:-1}),true,'Sheath interval is masked');
+    assert.ok(guard.stats.blocked>=3);geometry.dispose();
+});
+test('coarsening keeps a bend whose replacement capsule would intersect a finite wall patch',()=>{
+    const geometry=plane(1.25,.2),guard=createSharedAxisChordGuard({fallbackGeometry:geometry},0);
+    const initial=[[-3,1,0],[-2,1,0],[-1,1,0],[0,2,0],[1,1,0]];
+    const options={maxSpacing:20,maxTurn:3,maxArcLoss:.5,shapeTolerance:2,contactMargin:1,tipLength:30};
+    const run=collisionAwareCoarsening=>{
+        const coordinates=[0,1,2,3,4],positions=structuredClone(initial);
+        coarsenSharedAxisMesh(coordinates,positions,{tools:[{id:'wire',insertion:1000,radius:.3}],boundaries:[],previous:null,spacing:1,
+            options:{...options,collisionAwareCoarsening},canMergeChord:guard});return {coordinates,positions};
+    };
+    assert.deepEqual(run(0).coordinates,[0,1,4]);
+    assert.ok(run(1).coordinates.includes(3));assert.deepEqual(initial,[[-3,1,0],[-2,1,0],[-1,1,0],[0,2,0],[1,1,0]]);
+    geometry.dispose();
+});
