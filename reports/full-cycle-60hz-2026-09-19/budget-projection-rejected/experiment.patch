+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createSharedAxisNative,captureSharedAxisNative} from '../src/physics/kirchhoffSharedAxisNative.js';
+import {projectSharedAxisPredictor} from '../src/physics/kirchhoffSharedAxisPredictorProjection.js';
+import {iterateSharedAxisTimeStep,stepSharedAxis} from '../src/physics/kirchhoffSharedAxisTimeStep.js';
+
+function rod(){return createSharedAxisNative({tools:[{id:'wire',insertion:20}]});}
+test('private projection reduces a retained wall violation and leaves physical state and fixed DOFs untouched',()=>{
+    const s=rod(),edge=s.positions.length-2,p=s.layout.positions;
+    const evaluate=({b})=>({gap:b[1]-.25,jacobian:[0,0,0,0,1,0]});evaluate.sharedAxisGeometryOnly=true;
+    s.definitions.push({kind:'wall',edge,witness:{t:1},dofs:[p[edge],p[edge]+1,p[edge]+2,p[edge+1],p[edge+1]+1,p[edge+1]+2],evaluate});
+    const before=captureSharedAxisNative(s),result=projectSharedAxisPredictor(s);
+    assert.ok(result.increment);assert.ok(result.increment[p[edge+1]+1]>.2);
+    for(let d=0;d<s.fixed.length;d++)if(s.fixed[d])assert.equal(result.increment[d],0);
+    assert.deepEqual(captureSharedAxisNative(s),before);
+    assert.equal(projectSharedAxisPredictor(s,{maxDisplacement:.001}).increment,null);
+    assert.deepEqual(captureSharedAxisNative(s),before);
+});
