+    }
+    const increment=new Float64Array(s.layout.dofCount);
+    for(let n=0;n<positions.length;n++)for(let a=0;a<3;a++)increment[s.layout.positions[n]+a]=positions[n][a]-s.positions[n][a];
+    return {increment,corrections};
