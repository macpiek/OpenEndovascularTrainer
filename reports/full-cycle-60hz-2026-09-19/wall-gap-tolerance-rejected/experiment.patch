@@ -0,0 +1,28 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createSharedAxisLinear,solveSharedAxisLinear} from '../src/physics/kirchhoffSharedAxisLinear.js';
+
+test('contact activation can use a positional budget without relaxing force equations',()=>{
+    const layout={dofCount:2,band:1},chain={layout,hessian:Float64Array.from([1,1])};
+    const rows=[{id:'wall',kind:'wall',dofs:[1],jacobian:[1],gap:1e-5,multiplier:0}];
+    const options={rows,gradient:Float64Array.from([1,5e-5]),fixed:new Uint8Array(2),tolerance:1e-10};
+    const exact=solveSharedAxisLinear(createSharedAxisLinear(layout,rows,{lazy:true}),chain,options);
+    const loose=solveSharedAxisLinear(createSharedAxisLinear(layout,rows,{lazy:true}),chain,{...options,wallGapTolerance:1e-4});
+    assert.ok(exact.converged&&loose.converged);
+    assert.equal(loose.increment[0],exact.increment[0]);
+    assert.ok(loose.residual<=options.tolerance);
+    assert.ok(loose.factorizations<exact.factorizations);
+    assert.ok(rows[0].gap+loose.increment[1]>=-1e-4);
+    assert.equal(loose.multiplierIncrement[0],0);
+    assert.ok(Math.abs(rows[0].gap+exact.increment[1])<1e-10);
+});
+
+test('a violation beyond the positional budget still activates the wall',()=>{
+    const layout={dofCount:1,band:1},chain={layout,hessian:Float64Array.of(1)};
+    const rows=[{kind:'wall',dofs:[0],jacobian:[1],gap:1e-5,multiplier:0}];
+    const r=solveSharedAxisLinear(createSharedAxisLinear(layout,rows,{lazy:true}),chain,
+        {rows,gradient:Float64Array.of(1),fixed:new Uint8Array(1),tolerance:1e-10,wallGapTolerance:1e-4});
+    assert.ok(r.converged);assert.ok(r.multiplierIncrement[0]>0);
+    assert.ok(Math.abs(rows[0].gap+r.increment[0])<1e-10);
+    assert.ok(r.residual<=1e-10);
+});
