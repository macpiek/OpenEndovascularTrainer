+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createSharedAxisNative,captureSharedAxisNative} from '../src/physics/kirchhoffSharedAxisNative.js';
+import {projectSharedAxisPredictor} from '../src/physics/kirchhoffSharedAxisPredictorProjection.js';
+import {iterateSharedAxisTimeStep,stepSharedAxis} from '../src/physics/kirchhoffSharedAxisTimeStep.js';
+
+function rod(){return createSharedAxisNative({tools:[{id:'wire',insertion:20}]});}
+test('private projection reduces a retained wall violation and leaves physical state and fixed DOFs untouched',()=>{
+    const s=rod(),edge=s.positions.length-2,p=s.layout.positions;
+    const evaluate=({b})=>({gap:b[1]-.25,jacobian:[0,0,0,0,1,0]});evaluate.sharedAxisGeometryOnly=true;
+    s.definitions.push({kind:'wall',edge,witness:{t:1},dofs:[p[edge],p[edge]+1,p[edge]+2,p[edge+1],p[edge+1]+1,p[edge+1]+2],evaluate});
+    const before=captureSharedAxisNative(s),result=projectSharedAxisPredictor(s);
+    assert.ok(result.increment);assert.ok(result.increment[p[edge+1]+1]>.2);
+    for(let d=0;d<s.fixed.length;d++)if(s.fixed[d])assert.equal(result.increment[d],0);
+    assert.deepEqual(captureSharedAxisNative(s),before);
+    assert.equal(projectSharedAxisPredictor(s,{maxDisplacement:.001}).increment,null);
+    assert.deepEqual(captureSharedAxisNative(s),before);
+});
+test('projected predictor cancellation restores pose, reactions and rates while inertia keeps the incoming reference',()=>{
+    const s=rod();s.velocities=s.positions.map(()=>[0,2,0]);
+    const before=captureSharedAxisNative(s),velocities=s.velocities;let observed=false;
+    const it=iterateSharedAxisTimeStep(s,1/120,{velocityPredictor:1,predictorProjection:4,observeIteration:()=>{
+        observed=true;assert.deepEqual(s.dynamicStep.positions,before.positions);
+    }});
+    for(let n=0;n<100&&!observed;n++)assert.equal(it.next().done,false);
+    assert.ok(observed);it.return();assert.deepEqual(captureSharedAxisNative(s),before);
+    assert.equal(s.velocities,velocities);assert.equal(s.dynamicStep,null);assert.equal(s.wallFrictionStep,null);
+});
+test('the corrected guess still converges under the original physical certificates',()=>{
+    const a=rod(),b=rod();for(const s of [a,b]){s.fixed.fill(0);s.velocities=s.positions.map(()=>[0,2,0]);}
+    const ref=stepSharedAxis(a,1/120,{velocityPredictor:1}),out=stepSharedAxis(b,1/120,{velocityPredictor:1,predictorProjection:4});
+    assert.ok(ref.converged&&out.converged);assert.ok(out.certificateBound<=1e-6);
+    assert.ok(out.residual.length<=1e-5);
+    for(let n=0;n<a.positions.length;n++)for(let k=0;k<3;k++)assert.ok(Math.abs(a.positions[n][k]-b.positions[n][k])<1e-7);
+});
+
+test('undefined wall direction abandons only the private correction',()=>{
+    const s=rod(),edge=s.positions.length-2,p=s.layout.positions;
+    const evaluate=()=>{throw Object.assign(new Error('surface'),{code:'trial-outside-vessel'});};evaluate.sharedAxisGeometryOnly=true;
+    s.definitions.push({kind:'wall',edge,witness:{t:1},dofs:[p[edge],p[edge]+1,p[edge]+2,p[edge+1],p[edge+1]+1,p[edge+1]+2],evaluate});
+    const before=captureSharedAxisNative(s),result=projectSharedAxisPredictor(s);
+    assert.equal(result.increment,null);assert.equal(result.reason,'undefined-wall-normal');
+    assert.deepEqual(captureSharedAxisNative(s),before);
+});
+
+test('advancing-only correction leaves withdrawing and stationary guesses identical to the reference predictor',()=>{
+    function guess(feed,project){
+        const s=rod();s.velocities=s.positions.map(()=>[0,20,0]);let initial;
+        const iterator=iterateSharedAxisTimeStep(s,1/120,{velocityPredictor:1,feedById:feed,
+            predictorProjection:project?4:0,predictorProjectionAdvancingOnly:true,
+            observeIteration:()=>{initial??=s.positions.map(p=>p.slice());}});
+        for(let n=0;n<100&&!initial;n++)assert.equal(iterator.next().done,false);
+        assert.ok(initial);iterator.return();return initial;
+    }
+    for(const feed of [{wire:-1},{wire:0},{wire:1,catheter:-1}])assert.deepEqual(guess(feed,true),guess(feed,false));
+    assert.notDeepEqual(guess({wire:1},true),guess({wire:1},false));
+});
