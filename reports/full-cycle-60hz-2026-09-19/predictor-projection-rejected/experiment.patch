+import {sharedAxisOuterMaterialAt} from './kirchhoffSharedAxisNative.js';
+
+/** Bounded, private feasibility guess. No reactions, velocities, inertia
+ * targets or friction history are changed. Newton still owns all physical
+ * equations and certification; this is not an accepted PBD physics step. */
+export function projectSharedAxisPredictor(s,{sweeps=4,maxDisplacement=.5,tolerance=1e-5}={}){
+    if(!Number.isInteger(sweeps)||sweeps<1||sweeps>16||!(maxDisplacement>0)||!Number.isFinite(maxDisplacement))throw new RangeError('Invalid predictor projection options');
+    const positions=s.positions.map(p=>p.slice()),local={...s,positions,geometryKey:Symbol('predictor-projection')};
+    const index=new Int32Array(s.layout.dofCount).fill(-1);
+    for(let n=0;n<positions.length;n++)for(let a=0;a<3;a++)index[s.layout.positions[n]+a]=n*3+a;
+    const rows=s.definitions.filter(r=>r.kind==='length'||r.witness&&r.evaluate?.sharedAxisGeometryOnly);
+    let corrections=0;
+    for(let sweep=0;sweep<sweeps;sweep++){
+        let maximum=0;
+        for(let at=0;at<rows.length;at++){
+            const r=rows[sweep%2?rows.length-1-at:at],e=r.edge,a=positions[e],b=positions[e+1];
+            let gap,J;
+            if(r.kind==='length'){
+                const dx=b[0]-a[0],dy=b[1]-a[1],dz=b[2]-a[2],length=Math.sqrt(dx*dx+dy*dy+dz*dz);
+                if(!(length>0))return {increment:null,corrections,reason:'degenerate-edge'};
+                gap=length-(s.coordinates[e+1]-s.coordinates[e]);J=[-dx/length,-dy/length,-dz/length,dx/length,dy/length,dz/length];
+            }else{
+                const owner=sharedAxisOuterMaterialAt(s,e,r.witness.t,r.witness.owner);
+                let c;
+                try{c=r.evaluate({state:local,a,b,edge:e,radius:owner.body.radius,needHessian:false,reuseGeometry:true});}
+                catch(error){if(error.code==='trial-outside-vessel')return {increment:null,corrections,reason:'undefined-wall-normal'};throw error;}
+                gap=c.gap;J=c.jacobian;
+            }
+            if(!Number.isFinite(gap)||!J.every(Number.isFinite))return {increment:null,corrections,reason:'nonfinite-geometry'};
+            if(r.kind==='wall'&&gap>=0)continue;
+            maximum=Math.max(maximum,Math.abs(gap));if(Math.abs(gap)<=tolerance)continue;
+            let norm=0;for(let k=0;k<r.dofs.length;k++)if(!s.fixed[r.dofs[k]])norm+=J[k]*J[k];
+            if(!(norm>1e-20))continue;
+            const scale=-gap/norm;
+            for(let k=0;k<r.dofs.length;k++){
+                const dof=r.dofs[k],p=index[dof];if(s.fixed[dof])continue;
+                if(p<0)return {increment:null,corrections,reason:'non-position-constraint'};
+                positions[Math.floor(p/3)][p%3]+=scale*J[k];
+            }
+            corrections++;
+        }
+        for(let n=0;n<positions.length;n++)if(Math.hypot(...positions[n].map((v,k)=>v-s.positions[n][k]))>maxDisplacement)return {increment:null,corrections,reason:'displacement-limit'};
+        if(maximum<=tolerance)break;
+    }
+    const increment=new Float64Array(s.layout.dofCount);
+    for(let n=0;n<positions.length;n++)for(let a=0;a<3;a++)increment[s.layout.positions[n]+a]=positions[n][a]-s.positions[n][a];
+    return {increment,corrections};
+}
