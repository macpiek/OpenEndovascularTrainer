+// Scoped to one nonlinear solve. Contact discovery can restart at the same
+// pose with more inactive rows, producing an identical compact KKT system.
+// Compare the actual packed equations bit for bit: geometry identity alone
+// cannot certify the tangent, friction columns, loads or fixed constraints.
+const words = array => new Uint32Array(array.buffer, array.byteOffset, array.byteLength / 4);
+const identical = (a, b) => {
+    if (a.length !== b.length) return false;
+    for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
+    return true;
+};
+
+export function createSharedAxisExactLinearCache({maxBytes = 8 * 1024 * 1024, maxEntries = 32} = {}) {
+    let pose, bytes = 0;
+    const entries = [];
+    const diagnostics = {hits: 0, misses: 0, peakBytes: 0, reusedFactorizations: 0};
+    return {
+        diagnostics,
+        setPose(key) {
+            if (pose === key) return;
+            pose = key; entries.length = 0; bytes = 0;
+        },
+        read(w, tolerance) {
+            const matrix = words(w.matrix), rhs = words(w.residual), scales = words(w.scales);
+            for (let i = entries.length - 1; i >= 0; i--) {
+                const entry = entries[i];
+                if (entry.count !== w.count || entry.width !== w.band.kl || entry.tolerance !== tolerance ||
+                    !identical(rhs, entry.rhs) || !identical(scales, entry.scales) || !identical(matrix, entry.matrix)) continue;
+                diagnostics.hits++; diagnostics.reusedFactorizations += entry.result.factorizations;
+                if (entry.solution) w.solution.set(entry.solution);
+                return entry.result;
+            }
+            diagnostics.misses++;
+            return null;
+        },
+        write(w, tolerance, result) {
+            const size = w.matrix.byteLength + w.residual.byteLength + w.scales.byteLength +
+                (result.failure ? 0 : w.solution.byteLength);
+            if (size > maxBytes || maxEntries < 1) return;
+            while (entries.length && (bytes + size > maxBytes || entries.length >= maxEntries)) bytes -= entries.shift().size;
+            entries.push({count: w.count, width: w.band.kl, tolerance, size,
+                matrix: words(w.matrix).slice(), rhs: words(w.residual).slice(), scales: words(w.scales).slice(),
+                solution: result.failure ? null : w.solution.slice(), result: {...result}});
+            bytes += size; diagnostics.peakBytes = Math.max(diagnostics.peakBytes, bytes);
+        }
+    };
+}
