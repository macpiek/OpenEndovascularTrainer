+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createSharedAxisExactLinearCache} from '../src/physics/kirchhoffSharedAxisExactLinearCache.js';
+import {createSharedAxisLinear,solveSharedAxisLinear} from '../src/physics/kirchhoffSharedAxisLinear.js';
+
+test('exact cache owns snapshots, rejects one-bit changes and obeys its memory budget',()=>{
+    const cache=createSharedAxisExactLinearCache({maxBytes:128}),pose=Symbol();cache.setPose(pose);
+    const w={count:2,band:{kl:1},matrix:new Float64Array([2,0,0,2]),residual:new Float64Array([1,1]),
+        scales:new Float64Array([1,1]),solution:new Float64Array([-.5,-.5])};
+    cache.write(w,1e-8,{converged:true,residual:0,factorizations:2});
+    w.solution.fill(9);assert.ok(cache.read(w,1e-8));assert.deepEqual([...w.solution],[-.5,-.5]);
+    for(const key of ['matrix','residual','scales']) {
+        const bits=new BigUint64Array(w[key].buffer);bits[0]^=1n;
+        assert.equal(cache.read(w,1e-8),null,key);bits[0]^=1n;
+    }
+    w.matrix[1]=-0;assert.equal(cache.read(w,1e-8),null,'signed zero is not silently normalized');w.matrix[1]=0;
+    assert.equal(cache.read(w,1e-9),null,'a tighter certificate may take a different refinement path');
+    cache.setPose(pose);assert.ok(cache.read(w,1e-8));
+    for(let i=0;i<4;i++){w.residual[0]=i;cache.write(w,1e-8,{converged:true,residual:0,factorizations:1});}
+    assert.ok(cache.diagnostics.peakBytes<=128);
+    w.residual[0]=1;assert.equal(cache.read(w,1e-8),null,'evicted equation is not reused');
+    cache.setPose(Symbol());assert.equal(cache.read(w,1e-8),null);
+});
+
+test('contact discovery reuses identical compact equations but still checks new blockers and changed loads',()=>{
+    const layout={dofCount:3,band:1},chain={layout,hessian:new Float64Array([2,2,2])};
+    const first={id:'a',kind:'wall',dofs:[0],jacobian:[1],gap:-1,multiplier:0};
+    const cache=createSharedAxisExactLinearCache();cache.setPose(Symbol());
+    const options={gradient:new Float64Array(3),fixed:new Uint8Array(3),batchActivation:false};
+    const run=(rows,exactLinearCache,gradient=options.gradient)=>{
+        const trace=[];
+        const result=solveSharedAxisLinear(createSharedAxisLinear(layout,rows,{lazy:true}),chain,
+            {...options,gradient,rows,exactLinearCache,trace});
+        return {result,trace};
+    };
+    const original=run([first],cache);assert.ok(original.result.converged);
+    const separated={id:'b',kind:'wall',dofs:[1],jacobian:[1],gap:1,multiplier:0};
+    const reference=run([first,separated]),reused=run([first,separated],cache);
+    assert.equal(reused.result.factorizations,0);
+    for(const key of ['increment','multiplierIncrement'])assert.deepEqual(reused.result[key],reference.result[key]);
+    assert.deepEqual(reused.trace,reference.trace);
+    separated.gap=-2;
+    const blocked=run([first,separated],cache),blockedReference=run([first,separated]);
+    assert.ok(blocked.result.converged);assert.equal(blocked.result.increment[1],2);
+    assert.deepEqual(blocked.result.increment,blockedReference.result.increment);
+    assert.deepEqual(blocked.trace,blockedReference.trace);
+    const loaded=run([first,separated],cache,new Float64Array([0,0,1]));
+    assert.equal(loaded.result.increment[2],-.5);assert.ok(loaded.result.factorizations>0);
