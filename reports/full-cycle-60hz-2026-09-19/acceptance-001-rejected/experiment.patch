+++ b/tests/kirchhoffSharedAxisAcceptanceTolerance.test.js
@@ -0,0 +1,56 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {defineKirchhoffMaterialProfile} from '../src/physics/kirchhoffMaterialProfile.js';
+import {createSharedAxisNative,relaxSharedAxisNative,applySharedAxisNativeIncrement,extendSharedAxisNativeRows} from '../src/physics/kirchhoffSharedAxisNative.js';
+import {stepSharedAxis} from '../src/physics/kirchhoffSharedAxisTimeStep.js';
+
+const beam=defineKirchhoffMaterialProfile({id:'acceptance-test-beam',sampleEI1:()=>1e6,sampleGJ:()=>1e6/1.3});
+const rod=()=>createSharedAxisNative({tools:[{id:'wire',insertion:100,type:beam,wallStaticFriction:.2,wallKineticFriction:.1}]});
+
+test('a relaxed stopping budget preserves the original Newton path and skips its last small correction',()=>{
+    const outputs=[];
+    for(const forceAcceptanceTolerance of [1e-6,.01]) {
+        const s=rod(),trace=[];s.loads[s.layout.positions.at(-1)+1]=10;
+        const result=relaxSharedAxisNative(s,{forceAcceptanceTolerance,observeIteration:e=>trace.push({
+            force:e.base.force,torque:e.base.torque,constraint:e.base.constraint,positions:s.positions.map(p=>p.slice())})});
+        assert.ok(result.converged);assert.ok(result.residual.length<=1e-5);
+        assert.ok(Math.max(result.residual.force,result.residual.torque)<=forceAcceptanceTolerance);
+        outputs.push({s,result,trace});
+    }
+    const [reference,actual]=outputs;
+    assert.ok(actual.result.factorizations<reference.result.factorizations);
+    assert.ok(actual.result.residual.force>1e-6,'the test must exercise the explicit relaxed budget');
+    assert.deepEqual(actual.trace,reference.trace.slice(0,actual.trace.length),'same directions and line search until early acceptance');
+    const maxDifference=Math.max(...actual.s.positions.map((p,i)=>Math.hypot(...p.map((v,k)=>v-reference.s.positions[i][k]))));
+    assert.ok(maxDifference<1e-4,`${maxDifference} mm`);
+});
+
+test('relaxing force equilibrium does not accept stretched segments',()=>{
+    const s=rod(),dx=new Float64Array(s.layout.dofCount);dx[s.layout.positions.at(-1)]=.1;
+    applySharedAxisNativeIncrement(s,dx,new Float64Array(s.multipliers.length));
+    const result=relaxSharedAxisNative(s,{forceAcceptanceTolerance:1000});
+    assert.ok(result.converged);assert.ok(result.iterations>0);
+    assert.ok(result.residual.length<=1e-5);
+});
+
+test('the final dynamic certificate includes both equilibrium residual and the friction update',()=>{
+    const s=rod();
+    for(let e=1;e+1<s.positions.length;e++) {
+        extendSharedAxisNativeRows(s,[{kind:'wall',edge:e,id:`floor/${e}`,witness:{face:0,t:1},
+            dofs:[s.layout.positions[e],s.layout.positions[e+1]].flatMap(p=>[p,p+1,p+2]),
+            evaluate:({b})=>({gap:b[1],jacobian:[0,0,0,0,1,0]})}]);
+        s.multipliers[s.multipliers.length-1]=100;s.loads[s.layout.positions[e+1]+1]=-20;
+    }
+    const result=stepSharedAxis(s,1/60,{forceAcceptanceTolerance:.01,coupledFrictionNewton:true,liveWallNormalLoad:true,feedById:{wire:.1}});
+    assert.ok(result.converged,JSON.stringify(result));assert.ok(result.friction.converged);
+    assert.equal(result.certificateBound,Math.max(result.residual.force,result.residual.torque)+result.friction.forceChange);
+    assert.ok(result.certificateBound<=.01);assert.ok(result.residual.length<=1e-5);
+    assert.ok(result.quality.maxPenetration<=1e-5);
+});
+
+test('invalid stopping budgets cannot start a timestep',()=>{
+    for(const forceAcceptanceTolerance of [0,-1,NaN,Infinity,1e-8]) {
+        assert.throws(()=>stepSharedAxis(rod(),1/60,{forceAcceptanceTolerance}),/acceptance tolerance/);
+        assert.throws(()=>relaxSharedAxisNative(rod(),{forceAcceptanceTolerance}),/Invalid shared axis/);
+    }
+});
