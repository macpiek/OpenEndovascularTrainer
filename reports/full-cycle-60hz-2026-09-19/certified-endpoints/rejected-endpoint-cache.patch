+
+test('adjacent certified capsules reuse only exact endpoint distances and still visit the complete grid',()=>{
+    const field=anatomy.field,entry=fixture.insideContinuation.find(e=>e.clearance>2),a=entry.point.slice();
+    const b=a.map((v,k)=>v+(k===0?.01:0)),c=a.map((v,k)=>v+(k===0?.02:0));
+    const proof={knownInside:true,lowerBound:1},geometryToken=field.fallbackGeometry.boundsTree;
+    const previous=[];
+    field.visitCertifiedInsideCapsule({a,b,radius:.4,sampleCount:3,geometryToken},proof,(contact,t)=>{
+        previous.push(snapshot(contact,t));contact.signedDistance=999;contact.faceIndex=-500;
+    });
+    const before=field.getStats(),actual=[];
+    field.visitCertifiedInsideCapsule({a:b,b:c,radius:.7,sampleCount:3,geometryToken},proof,(contact,t)=>actual.push(snapshot(contact,t)));
+    const stats=field.getStats();
+    assert.deepEqual(actual.map(x=>x.t),[0,1,1/3,2/3]);
+    assert.equal(actual[0].distance,previous[1].distance);
+    assert.equal(actual[0].face,previous[1].face);
+    assert.equal(actual[0].gap,previous[1].distance-.7);
+    assert.equal(stats.certifiedEndpointReuses-before.certifiedEndpointReuses,1);
+    assert.equal(stats.certifiedCapsuleSamples-before.certifiedCapsuleSamples,4);
+    assert.equal(stats.bvhContactRefinements-before.bvhContactRefinements,3);
+    const misses=field.getStats().certifiedEndpointReuses;
+    assert.equal(field.visitCertifiedInsideCapsule({a:c,b:a,radius:.4,sampleCount:3,geometryToken},null,()=>assert.fail()),false,'distance cache cannot supply the missing proof');
+    assert.equal(field.visitCertifiedInsideCapsule({a:c,b:a,radius:.4,sampleCount:3,geometryToken:{}},proof,()=>assert.fail()),false,'cache cannot validate a replaced geometry');
+    field.visitCertifiedInsideCapsule({a:c.map((v,k)=>v+(k===1?1e-9:0)),b:a,radius:.4,sampleCount:3,geometryToken},proof,()=>{});
+    assert.equal(field.getStats().certifiedEndpointReuses,misses,'nearby coordinates are not exact cache matches');
+});
