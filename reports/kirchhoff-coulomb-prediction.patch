@@ -0,0 +1,128 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { coulombPredictionContract, createAcceptedCoulombHistory, predictCoulombIncrement } from '../src/physics/kirchhoffCoulombPrediction.js';
+import { solveCoulombWithPrediction, solveSeededCoulombNewton } from '../src/physics/kirchhoffCoulombNewtonSolver.js';
+
+function fixture() {
+    const contact = { objectId: 10, id: 'contact', kind: 'side', feature: 'lumen',
+        innerMaterialSegmentId: 0, outerMaterialSegmentId: 0, innerT: .5,
+        normalLambda: 3, tangentLambda: [2, 1], tangentU: [0, 1, 0], tangentV: [-1, 0, 0] };
+    const system = { solveId: 1, state: { executedSteps: 10 }, dt: 1 / 120, count: 5, residualLawVersion: 'law-1',
+        bodies: [1, 2].map(objectId => ({ objectId, materialRowStart: 0, materialCoordinate: [0, 1, 2] })),
+        rows: [{ kind: 'material', side: 0, local: 9, lambda: 2 }, { kind: 'normal', identity: contact, lambda: 1 },
+            { kind: 'additional', local: 0, lambda: .25 }, { kind: 'additional', local: 1, lambda: .5 },
+            { kind: 'additional', sourceKind: 'wall', local: 2, lambda: 8 }],
+        groups: [{ rows: [2, 3], normalRow: 1 }], frictionMetadata: [{ scope: 'lumen', additionalRows: [0, 1],
+            contact, axes: [[0, 1, 0], [-1, 0, 0]], forceSide: 0 }] };
+    const trial = { solveId: 1, physicalStep: 10, trial: 2, scale: .5, provisional: true,
+        mechanics: { contacts: [contact], material: [{ bodyId: 1, adaptationLambdaX: [0, 7, 0] }] } };
+    return { system, trial, outcome: { solveId: 1, accepted: true, trial: 2, scale: .5 },
+        contract: coulombPredictionContract(system, 'run-1') };
+}
+
+test('accepted actual totals and world Ft are converted to current increments without mutating sources', () => {
+    const { system, trial, outcome, contract } = fixture();
+    system.increment = [100, 100, 100, 100, 100]; // Unscaled linear target is deliberately unrelated.
+    const before = structuredClone({ system, trial, outcome });
+    const history = createAcceptedCoulombHistory(system, trial, outcome, contract);
+    assert.deepEqual({ system, trial, outcome }, before);
+    const current = structuredClone(system); current.solveId = 2; current.rows[0].lambda = 4;
+    const prediction = predictCoulombIncrement(current, history, contract);
+    assert.deepEqual(prediction.increment, Float64Array.of(3, 2, 1.75, .5, 0));
+    assert.equal(prediction.diagnostics.mappedRows, 4);
+    assert.equal(prediction.diagnostics.families.wall.misses['accepted-value-unavailable'], 1);
+    trial.mechanics.contacts[0].tangentLambda.fill(999); trial.mechanics.material[0].adaptationLambdaX.fill(999);
+    assert.deepEqual(predictCoulombIncrement(current, history, contract).increment, prediction.increment, 'owned accepted snapshot');
+});
+
+for (const field of ['residualLawVersion', 'historyVersion', 'contextId', 'dt']) test(`changed ${field} invalidates numerical history`, () => {
+    const f = fixture(), history = createAcceptedCoulombHistory(f.system, f.trial, f.outcome, f.contract);
+    f.system.solveId = 2;
+    const changed = { ...f.contract, [field]: field === 'dt' ? 1 / 60 : 'different' };
+    const prediction = predictCoulombIncrement(f.system, history, changed);
+    assert.equal(prediction.eligible, false); assert.equal(prediction.diagnostics.reason, 'contract-mismatch');
+    assert.ok(prediction.increment.every(value => value === 0));
+});
+
+test('rejected, unmatched and future trials cannot supply accepted history', () => {
+    const f = fixture();
+    for (const outcome of [{ ...f.outcome, accepted: false }, { ...f.outcome, solveId: 2 }, { ...f.outcome, trial: 1 }, { ...f.outcome, scale: .25 }])
+        assert.throws(() => createAcceptedCoulombHistory(f.system, f.trial, outcome, f.contract), /matching accepted trial/);
+    const history = createAcceptedCoulombHistory(f.system, f.trial, f.outcome, f.contract);
+    assert.equal(predictCoulombIncrement(f.system, history, f.contract).diagnostics.reason, 'history-not-earlier');
+});
+
+test('a stale supplied contract cannot conceal a changed law on the current system', () => {
+    const f = fixture(), history = createAcceptedCoulombHistory(f.system, f.trial, f.outcome, f.contract);
+    f.system.solveId = 2; f.system.residualLawVersion = 'split-physical-motion-v2';
+    const prediction = predictCoulombIncrement(f.system, history, f.contract);
+    assert.equal(prediction.eligible, false); assert.equal(prediction.diagnostics.reason, 'current-system-contract-mismatch');
+    assert.throws(() => createAcceptedCoulombHistory(f.system, f.trial, f.outcome, f.contract), /current law/);
+});
+
+test('material/feature relabelling in reused contact objects is a miss, with no interpolation or force cutoff', () => {
+    const f = fixture(); f.trial.mechanics.material[0].adaptationLambdaX[1] = 1e-30;
+    const history = createAcceptedCoulombHistory(f.system, f.trial, f.outcome, f.contract);
+    f.system.solveId = 2; f.system.rows[0].lambda = 0;
+    assert.equal(predictCoulombIncrement(f.system, history, f.contract).increment[0], 1e-30);
+    f.system.frictionMetadata[0].contact.outerMaterialSegmentId = 1; // Same pooled object and ID, different owner label.
+    const changed = predictCoulombIncrement(f.system, history, f.contract);
+    assert.equal(changed.diagnostics.mappedRows, 1); assert.deepEqual(Array.from(changed.increment).slice(1), [0, 0, 0, 0]);
+    f.system.bodies[0].materialCoordinate[1] = 1.01;
+    assert.equal(predictCoulombIncrement(f.system, history, f.contract).eligible, false);
+});
+
+test('duplicate accepted contact keys are rejected for both Fn and Ft', () => {
+    const f = fixture(); f.trial.mechanics.contacts.push(structuredClone(f.trial.mechanics.contacts[0]));
+    const history = createAcceptedCoulombHistory(f.system, f.trial, f.outcome, f.contract); f.system.solveId = 2;
+    assert.equal(history.duplicateKeys, 1);
+    assert.equal(predictCoulombIncrement(f.system, history, f.contract).diagnostics.mappedRows, 1);
+});
+
+function solveFixture(prediction, extra = {}, certify = () => true) {
+    const args = [Float64Array.of(2), Float64Array.of(1), Float64Array.of(-Infinity), Float64Array.of(Infinity), 1, 1, []];
+    const baseOptions = { tolerance: 1e-12, initialFree: Uint8Array.of(1) };
+    const options = { ...baseOptions, prediction, certifyPrediction: certify, ...extra };
+    let calls = 0, fallbackResult;
+    const result = solveCoulombWithPrediction(...args, options, () => { calls++;
+        return fallbackResult = solveSeededCoulombNewton(...args, baseOptions); });
+    return { result, calls, fallbackResult, args };
+}
+
+test('a certified numerical start avoids the seed and requires the independent reconstruction gate', () => {
+    const prediction = { eligible: true, increment: Float64Array.of(.5), diagnostics: { mappedRows: 1 } };
+    let gates = 0;
+    const { result, calls } = solveFixture(prediction, {}, () => { gates++; return true; });
+    assert.ok(result.diagnostics.converged); assert.equal(calls, 0); assert.equal(gates, 1);
+    assert.equal(result.diagnostics.factorizations, 0); assert.equal(result.diagnostics.prediction.accepted, true);
+    const refused = solveFixture(prediction, {}, () => false);
+    assert.equal(refused.calls, 1); assert.equal(refused.result.diagnostics.prediction.reason, 'prediction-reconstruction-residual');
+});
+
+test('failed prediction has one bounded attempt and leaves exact seeded fallback/hints intact, including rejected costs', () => {
+    const prediction = { eligible: true, increment: Float64Array.of(100), diagnostics: { mappedRows: 1 } };
+    const before = prediction.increment.slice();
+    const { result, fallbackResult, calls } = solveFixture(prediction, { maxPredictionNewtonIterations: 1 });
+    assert.equal(calls, 1); assert.ok(result.diagnostics.converged);
+    assert.deepEqual(result.increment, fallbackResult.increment); assert.deepEqual(prediction.increment, before);
+    assert.equal(result.diagnostics.prediction.factorizations, 1);
+    assert.equal(result.diagnostics.factorizations, fallbackResult.diagnostics.factorizations + 1);
+    assert.equal(fallbackResult.diagnostics.prediction, undefined, 'fallback diagnostics remain an owned snapshot');
+    assert.ok(result.diagnostics.maximumLinearBackwardError >= 0);
+});
+
+test('four-factor cap has no hidden map/cold retries, and unusable guesses skip straight to fallback', () => {
+    const args = [Float64Array.of(0), Float64Array.of(1), Float64Array.of(-Infinity), Float64Array.of(Infinity), 1, 1, []];
+    let calls = 0;
+    const result = solveCoulombWithPrediction(...args, { tolerance: 1e-10,
+        prediction: { eligible: true, increment: Float64Array.of(0) }, certifyPrediction: () => true },
+    () => { calls++; return { diagnostics: { converged: false, factorizations: 2, rowSwaps: 7, linearResidualFailures: 3, maximumPivotGrowth: 4 } }; });
+    assert.equal(calls, 1); assert.equal(result.diagnostics.prediction.factorizations, 4);
+    assert.equal(result.diagnostics.factorizations, 6); assert.equal(result.diagnostics.rowSwaps, 7);
+    assert.equal(result.diagnostics.linearResidualFailures, 3); assert.equal(result.diagnostics.maximumPivotGrowth, 4);
+    for (const increment of [Float64Array.of(NaN), new Float64Array(2)]) {
+        const out = solveFixture({ eligible: true, increment });
+        assert.equal(out.calls, 1); assert.equal(out.result.diagnostics.prediction.attempted, false);
+    }
+    assert.throws(() => solveFixture({ eligible: false }, { maxPredictionNewtonIterations: 5 }), /between 0 and 4/);
+});
