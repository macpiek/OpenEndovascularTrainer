+    const residual = Float64Array.from(p.rhs);
+    if (reconstructed) {
+        for (let i = 0; i < p.count; i++) residual[i] -= p.rows[i].alpha * x[i];
+        for (let side = 0; side < p.columns.length; side++) for (let dof = 0; dof < p.columns[side].length; dof++) {
+            const column = p.columns[side][dof]; let response = 0;
+            for (let k = 0; k < column.length; k += 2) response += column[k + 1] * x[column[k]];
+            const correction = p.weights[side][dof] * response;
+            for (let k = 0; k < column.length; k += 2) residual[column[k]] -= column[k + 1] * correction;
+        }
