 import { projectCoupledEllipse } from './kirchhoffCoupledFrictionSolver.js';
 import { measureCoupledLoadKKT, solveCoupledLoadQP } from './kirchhoffCoupledLoadSolver.js';
 import { createCoulombBandLayout, createCoulombBandLU } from './kirchhoffCoulombBandLU.js';
+
+/** One optional NUMERICAL prediction attempt before the caller's unchanged
+ * seeded path. The caller supplies an owned increment, an independent
+ * reconstructed-response certificate, and the exact existing fallback.
+ * This wrapper publishes no history and writes no mechanical state. Full
+ * original load KKT remains mandatory inside Newton. A failed attempt never
+ * supplies iterates or working-set hints to the fallback.
+ */
+export function solveCoulombWithPrediction(matrix, rhs, lower, upper, count, band, groups, options, fallback) {
+    if (typeof fallback !== 'function') throw new TypeError('The unchanged seeded fallback is required');
+    const prediction = options.prediction;
+    const limit = options.maxPredictionNewtonIterations ?? 4;
+    if (!Number.isInteger(limit) || limit < 0 || limit > 4) throw new RangeError('Prediction Newton budget must be between 0 and 4');
+    let attempt, accepted = false, reason = prediction?.diagnostics?.reason ?? 'no-prediction';
+    if (prediction?.eligible) {
+        if (prediction.increment?.length !== count || !prediction.increment.every(Number.isFinite)) reason = 'invalid-prediction-increment';
+        else if (typeof options.certifyPrediction !== 'function') reason = 'missing-reconstruction-certificate';
+        else {
+            attempt = solveCoulombNewton(matrix, rhs, lower, upper, count, band, groups, { ...options,
+                initialIncrement: prediction.increment, coulombLinearSolver: 'band-lu',
+                normalMap: options.predictionNormalMap ?? 'projection', maxCoulombNewtonIterations: limit });
+            accepted = attempt.diagnostics.converged && options.certifyPrediction(attempt) === true;
+            reason = accepted ? 'converged' : attempt.diagnostics.converged ? 'prediction-reconstruction-residual' : attempt.diagnostics.status;
+        }
+    }
+    const result = accepted ? attempt : fallback();
+    // Diagnostic aggregation preserves the root's all-attempt LU accounting.
+    // Copy the final diagnostic object so a callback's stored result remains
+    // a valid snapshot of its own solve, rather than acquiring hidden costs.
+    const diagnostics = { ...result.diagnostics };
+    if (attempt && !accepted) {
+        for (const key of ['factorizations', 'iterations', 'backtracks', 'gradientFallbacks', 'boundRecoveries', 'rowSwaps', 'linearResidualFailures'])
+            if (key in diagnostics || key in attempt.diagnostics) diagnostics[key] = (diagnostics[key] ?? 0) + (attempt.diagnostics[key] ?? 0);
+        for (const key of ['maximumLinearBackwardError', 'maximumPivotGrowth'])
+            if (key in diagnostics || key in attempt.diagnostics) diagnostics[key] = Math.max(diagnostics[key] ?? 0, attempt.diagnostics[key] ?? 0);
+    }
+    diagnostics.prediction = { attempted: Boolean(attempt), accepted, reason, budget: limit,
+        mappedRows: prediction?.diagnostics?.mappedRows ?? 0, factorizations: attempt?.diagnostics.factorizations ?? 0,
+        iterations: attempt?.diagnostics.iterations ?? 0, backtracks: attempt?.diagnostics.backtracks ?? 0,
+        maximumResidual: attempt?.diagnostics.maximumResidual ?? null };
