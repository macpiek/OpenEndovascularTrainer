+const MATERIAL_FIELDS = ['bendTwistLambda1', 'bendTwistLambda2', 'bendTwistLambda3',
+    'adaptationLambdaX', 'adaptationLambdaY', 'adaptationLambdaZ'];
+const LAW_FILES = ['src/physics/endovascularPhysicsWorld.js', 'src/physics/kirchhoffSurfaceFriction.js'];
+const finite = value => typeof value === 'number' && Number.isFinite(value);
+const keyOf = parts => JSON.stringify(parts);
+
+/** Versions describe the residual law and this numerical history format.
+ * Context is an explicit run/constraint namespace: run-local object IDs from
+ * unrelated captures must never match just because their numbers coincide.
+ */
+export function coulombPredictionContract(system, contextId, historyVersion = 'accepted-total-strict-material-v1') {
+    const hashes = new Map(system.source ?? []);
+    const residualLawVersion = system.residualLawVersion ??
+        (LAW_FILES.every(file => hashes.has(file)) ? LAW_FILES.map(file => `${file}:${hashes.get(file)}`).join('|') : null);
+    return { contextId, historyVersion, residualLawVersion, dt: system.dt };
+}
+
+function validContract(contract) {
+    return ['contextId', 'historyVersion', 'residualLawVersion'].every(key =>
+        typeof contract?.[key] === 'string' && contract[key].length > 0) && finite(contract.dt) && contract.dt > 0;
+}
+
+function contractMatchesSystem(system, contract) {
+    const current = coulombPredictionContract(system, contract.contextId, contract.historyVersion);
+    return current.dt === contract.dt && current.residualLawVersion === contract.residualLawVersion;
+}
+
+function contactKey(contact, bodyIds) {
+    // Exact material labels, feature and quadrature sample are required.
+    // The outer cell is deliberately retained in this first conservative
+    // mapping: a cell migration is a miss, never an inferred force transfer.
+    if (!contact || contact.objectId == null || !contact.id || !contact.kind || !contact.feature ||
+        contact.innerMaterialSegmentId == null || contact.outerMaterialSegmentId == null || !finite(contact.innerT)) return null;
+    return keyOf(['contact', bodyIds, contact.objectId, contact.id, contact.kind, contact.feature,
+        contact.innerMaterialSegmentId, contact.outerMaterialSegmentId, contact.innerT, contact.generation ?? null]);
+}
+
+function materialDescription(system, row) {
+    const body = system.bodies?.[row.side], start = body?.materialRowStart;
+    if (body?.objectId == null || !Number.isInteger(start) || !Number.isInteger(row.local)) return null;
+    const segment = start + Math.floor(row.local / 6), component = row.local % 6;
+    const coordinates = body.materialCoordinate;
+    const samples = component < 3 && segment > start ? [segment - 1, segment, segment + 1] : [segment, segment + 1];
+    if (!samples.every(index => finite(coordinates?.[index]))) return null;
+    return { key: keyOf(['material', body.objectId, component, component < 3 && segment === start ? 'boundary' : 'interior',
+        samples.map(index => coordinates[index])]), bodyId: body.objectId, segment, component };
+}
+
+/** Read-only descriptors in ORIGINAL sorted row coordinates. The input uses
+ * the owned frozen-system metadata contract; no world or assembly dependency
+ * is imported. Live callers can supply the same metadata after assembly.
+ */
+export function describeCoulombPrediction(system) {
+    const bodyIds = (system.bodies ?? []).map(body => body.objectId);
+    const rows = system.rows.map(row => {
+        const family = row.kind === 'material' ? 'material' : row.kind === 'normal' ? 'normal' : row.sourceKind ?? 'additional';
+        const material = family === 'material' ? materialDescription(system, row) : null;
+        return { family, lambda: row.lambda, key: material?.key ?? (family === 'normal' ? contactKey(row.identity, bodyIds) : null),
+            material, reason: family === 'material' || family === 'normal' ? 'missing-identity' : 'accepted-value-unavailable' };
+    });
+    const metadata = new Map((system.frictionMetadata ?? []).map(group => [keyOf(group.additionalRows), group]));
+    const groups = [];
+    for (const group of system.groups ?? []) {
+        const localRows = Array.from(group.rows, index => system.rows[index]?.local);
+        const source = metadata.get(keyOf(localRows));
+        const key = source?.scope === 'lumen' ? contactKey(source.contact, bodyIds) : null;
+        const axes = source?.axes, validAxes = axes?.length === 2 && axes.every(axis => axis?.length === 3 && axis.every(finite));
+        const validSide = source?.forceSide === 0 || source?.forceSide === 1;
+        const descriptor = { key: validAxes && validSide ? key : null, rows: Array.from(group.rows),
+            axes: validAxes ? axes.map(axis => Array.from(axis)) : null, forceSide: source?.forceSide,
+            source, normalRow: group.normalRow };
+        groups.push(descriptor);
+        for (const index of group.rows) rows[index] = { ...rows[index], family: source?.scope === 'external' ? 'external-friction' : 'friction',
+            key: descriptor.key, reason: source?.scope === 'external' ? 'external-identity-unavailable' : 'missing-identity' };
+    }
+    return { rows, groups, bodyIds };
+}
+
+/** Publish ONLY an explicitly accepted trial. Actual post-remap/cone-repair
+ * multipliers are read from trial.mechanics, never fabricated from an
+ * unscaled linear target. Owned scalar/vector snapshots survive later edits
+ * to source metadata. The caller owns acceptance/rollback timing.
+ */
+export function createAcceptedCoulombHistory(system, trial, outcome, contract) {
+    if (!validContract(contract) || !contractMatchesSystem(system, contract))
+        throw new TypeError('Explicit prediction context and current law/history versions and dt are required');
+    if (!outcome?.accepted || outcome.solveId !== system.solveId || trial?.solveId !== system.solveId ||
+        trial.trial !== outcome.trial || trial.scale !== outcome.scale || !finite(outcome.scale) || outcome.scale < 0 || outcome.scale > 1)
+        throw new Error('Prediction history requires a matching accepted trial and actual scale');
+    const described = describeCoulombPrediction(system), scalars = new Map(), forces = new Map();
+    const duplicate = new Set(), put = (map, key, value) => {
+        if (!key || duplicate.has(key)) return;
+        if (map.has(key)) { map.delete(key); duplicate.add(key); return; }
+        map.set(key, value);
+    };
+    const material = new Map((trial.mechanics?.material ?? []).map(body => [body.bodyId, body]));
+    for (const row of described.rows) if (row.material) {
+        const identity = row.material, value = material.get(identity.bodyId)?.[MATERIAL_FIELDS[identity.component]]?.[identity.segment];
+        if (finite(value)) put(scalars, identity.key, value);
+    }
+    for (const contact of trial.mechanics?.contacts ?? []) {
+        const key = contactKey(contact, described.bodyIds);
+        if (finite(contact.normalLambda)) put(scalars, key, contact.normalLambda);
+        const u = contact.tangentU, v = contact.tangentV, lambda = contact.tangentLambda;
+        if (u?.length === 3 && v?.length === 3 && lambda?.length === 2 && [...u, ...v, ...lambda].every(finite))
+            put(forces, key, Float64Array.from(u, (component, i) => component * lambda[0] + v[i] * lambda[1]));
+    }
+    for (const key of duplicate) { scalars.delete(key); forces.delete(key); }
+    // No extrapolation or data imputation for boundary/fold/external rows.
+    return { contract: { ...contract }, solveId: system.solveId, physicalStep: trial.physicalStep,
+        acceptedScale: outcome.scale, scalars, forces, duplicateKeys: duplicate.size };
+}
+
+/** Predict a NUMERICAL increment without writing any mechanical state. Exact
+ * misses stay at zero increment; no force is clipped, transferred, or dropped
+ * from the current solve. Every row/cone remains in the subsequent KKT check.
+ */
+export function predictCoulombIncrement(system, history, contract) {
+    const increment = new Float64Array(system.count), described = describeCoulombPrediction(system);
+    const diagnostics = { mappedRows: 0, rowCount: system.count, families: {}, reason: null };
+    let compatible = validContract(contract) && history && validContract(history.contract);
+    if (!compatible) diagnostics.reason = history ? 'invalid-contract' : 'no-history';
+    else if (['contextId', 'historyVersion', 'residualLawVersion', 'dt'].some(key => history.contract[key] !== contract[key])) {
+        compatible = false; diagnostics.reason = 'contract-mismatch';
+    } else if (!contractMatchesSystem(system, contract)) {
+        compatible = false; diagnostics.reason = 'current-system-contract-mismatch';
+    } else if (!(history.solveId < system.solveId) || !(history.physicalStep <= system.state.executedSteps)) {
+        compatible = false; diagnostics.reason = 'history-not-earlier';
+    }
+    const mapped = new Uint8Array(system.count), reasons = [];
+    if (compatible) {
+        const keys = new Map();
+        for (const row of described.rows) if (row.family !== 'friction' && row.key) keys.set(row.key, (keys.get(row.key) ?? 0) + 1);
+        described.rows.forEach((row, i) => {
+            if (row.family === 'friction' || row.family === 'external-friction') return;
+            if (row.key && keys.get(row.key) === 1 && history.scalars.has(row.key) && finite(row.lambda)) {
+                increment[i] = history.scalars.get(row.key) - row.lambda; mapped[i] = 1;
+            } else reasons[i] = row.key ? 'no-exact-history' : row.reason;
+        });
+        const groupKeys = new Map();
+        for (const group of described.groups) if (group.key) groupKeys.set(group.key, (groupKeys.get(group.key) ?? 0) + 1);
+        for (const group of described.groups) {
+            const force = group.key && groupKeys.get(group.key) === 1 ? history.forces.get(group.key) : null;
+            if (force && group.forceSide === 0 && group.rows.every(i => finite(described.rows[i].lambda))) {
+                group.rows.forEach((row, axis) => {
+                    const direction = group.axes[axis];
+                    increment[row] = direction[0] * force[0] + direction[1] * force[1] + direction[2] * force[2] - described.rows[row].lambda;
+                    mapped[row] = 1;
+                });
+            } else for (const row of group.rows) reasons[row] = group.key ? 'no-exact-history' : described.rows[row].reason;
+        }
+    }
+    described.rows.forEach((row, i) => {
+        const family = diagnostics.families[row.family] ??= { rows: 0, mapped: 0, misses: {} };
+        family.rows++; family.mapped += mapped[i]; diagnostics.mappedRows += mapped[i];
+        if (!mapped[i]) { const reason = diagnostics.reason ?? reasons[i] ?? 'no-exact-history'; family.misses[reason] = (family.misses[reason] ?? 0) + 1; }
+    });
+    return { increment, eligible: diagnostics.mappedRows > 0, contract: { ...contract }, diagnostics };
+}
