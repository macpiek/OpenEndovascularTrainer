+
+const systemModule = process.env.OET_TWO_CHANNEL_SYSTEM_SOURCE_ROOT
+    ? pathToFileURL(resolve(process.env.OET_TWO_CHANNEL_SYSTEM_SOURCE_ROOT, 'src/physics/kirchhoffTwoChannelSystem.js'))
