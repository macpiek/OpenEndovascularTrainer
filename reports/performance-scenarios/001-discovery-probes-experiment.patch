+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {BufferGeometry,Float32BufferAttribute} from 'three';
+import {createSharedAxisNative,assembleSharedAxisNative,extendSharedAxisNativeRows,feedSharedAxisNative} from '../src/physics/kirchhoffSharedAxisNative.js';
+import {createSharedAxisContacts} from '../src/physics/kirchhoffSharedAxisContacts.js';
+import {createSharedAxisVesselDiscovery} from '../src/physics/kirchhoffSharedAxisVesselWitnesses.js';
+import {createSharedAxisConstraintRowPool} from '../src/physics/kirchhoffSharedAxisConstraintRows.js';
+import {captureSharedAxisReplay,restoreSharedAxisReplay} from './helpers/sharedAxisReplay.js';
+
+const rowKey=r=>`${r.kind}/${r.edge}/${r.sample}/${r.sampleT}/${r.id}`;
+function fixture(separateDiscoveryRows,{before=[],after=[],distance=.7}={}) {
+    const geometry=new BufferGeometry().setAttribute('position',new Float32BufferAttribute([-100,-100,10,100,-100,10,0,100,10],3)),calls=[];
+    const field={fallbackGeometry:geometry,voxelSize:1,queryCapsuleSoA(x,y,z,r,index,out,face,inside,clearance,branch,near,length,count,physical,finite,visit){
+        calls.push(x[0]);const c={faceIndex:0,signedGap:distance-r[0],signedDistance:distance,segmentT:.5};
+        visit?.(c,.5);return Object.assign(out,c);
+    }};
+    const discovery=createSharedAxisVesselDiscovery(field,0,{queryReuse:false});
+    const s=createSharedAxisNative({tools:[{id:'wire',insertion:15}],wallSamples:[...before,discovery,...after],separateDiscoveryRows});
+    s.cacheMechanicalAssembly=true;s.loads[s.layout.dofCount-1]=.123;
+    let materialReads=0;const body=s.materials[0].body,rest=body.restRotation1;
+    Object.defineProperty(body,'restRotation1',{get(){materialReads++;return rest;}});
+    const pool=createSharedAxisConstraintRowPool();
+    return {s,field,geometry,calls,discovery,pool,get materialReads(){return materialReads;},
+        run:earlyContactPreflight=>assembleSharedAxisNative(s,{earlyContactPreflight,rowStorage:pool.acquire(),reuseConstraintWork:true})};
+}
+function physical(s,r) {
+    return {energy:r.energy,force:r.force,torque:r.torque,constraint:r.constraint,
+        g:s.chain.gradient.slice(),H:s.chain.tangent.slice(),rows:r.rows.filter(row=>!s.wallSamples[row.sample]?.sharedAxisDiscoveryOnly)
+            .map(row=>({key:rowKey(row),gap:row.gap,jacobian:row.jacobian.slice(),H:row.geometricHessian?.slice()}))};
+}
+for(const early of [false,true])test(`separate discovery keeps query order, witnesses and complete physical assembly (preflight=${early})`,()=>{
+    const outputs=[];
+    for(const separate of [false,true]) {
+        const f=fixture(separate);
+        try {
+            assert.throws(()=>f.run(early),/shared-axis-wall-discovery/);
+            assert.deepEqual(f.calls,[0,5,10]);assert.equal(f.materialReads===0,early);
+            const ids=[...f.s.pendingVesselRows.keys()];
+            extendSharedAxisNativeRows(f.s,[...f.s.pendingVesselRows.values()]);f.s.pendingVesselRows.clear();
+            const first=physical(f.s,f.run(early));assert.equal(f.calls.length,3);
+            f.s.positions[2][1]+=.01;f.s.geometryKey=Symbol('moved');
+            const second=physical(f.s,f.run(early));assert.equal(f.calls.length,6);
+            // A throwing query is never cached as a valid pose certificate.
+            const query=f.field.queryCapsuleSoA;f.field.queryCapsuleSoA=()=>{throw new Error('query failed');};
+            f.s.geometryKey=Symbol('bad query');assert.throws(()=>f.run(early),/query failed/);
+            f.field.queryCapsuleSoA=query;f.run(early);assert.equal(f.calls.length,9);
+            outputs.push({first,second,ids});
