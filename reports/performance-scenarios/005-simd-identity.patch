+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {sameBytesSimd} from '../src/physics/sharedAxisByteEquality.js';
+
+test('SIMD compares all bytes, chunk boundaries, tails and unaligned views without modifying inputs',()=>{
+    for(const length of [0,1,15,16,17,16384,262143,262144,262145,800003]) {
+        const storage=new Uint8Array(length+13),a=storage.subarray(3,3+length);
+        for(let i=0;i<length;i++)a[i]=(i*37+19)&255;
+        const b=a.slice(),saved=a.slice();assert.equal(sameBytesSimd(a,b),true);
+        for(const index of new Set([0,15,16,262143,262144,length-1].filter(i=>i>=0&&i<length))) {
+            b[index]^=128;assert.equal(sameBytesSimd(a,b),false,`${length}/${index}`);
+            b[index]^=128;assert.equal(sameBytesSimd(a,b),true);
+        }
+        assert.deepEqual(a,saved);assert.deepEqual(b,saved);
+    }
+    assert.equal(sameBytesSimd(new Uint8Array(1),new Uint8Array(2)),false);
+});
+
+test('sequential large and small comparisons cannot retain a prior match or mismatch',()=>{
+    const a=new Uint8Array(900009).fill(7),b=a.slice();b[800000]=8;
+    for(let i=0;i<4;i++){
+        assert.equal(sameBytesSimd(a,b),false);
+        assert.equal(sameBytesSimd(a.subarray(5,500003),b.subarray(5,500003)),true);
+        assert.equal(sameBytesSimd(new Uint8Array([1,2]),new Uint8Array([1,3])),false);
+        assert.equal(sameBytesSimd(a,a.slice()),true);
+    }
+});
+
+
+test('an unavailable SIMD runtime requests the caller fallback and remains safe',async()=>{
+    const original=WebAssembly.Module;
+    try {
+        WebAssembly.Module=function(){throw new Error('SIMD unavailable');};
+        const fallback=await import('../src/physics/sharedAxisByteEquality.js?unsupported');
+        const bytes=new Uint8Array([1,2]);assert.equal(fallback.sameBytesSimd(bytes,bytes),null);
+        WebAssembly.Module=original;
+        assert.equal(fallback.sameBytesSimd(bytes,bytes),null);
+        assert.equal(fallback.sameBytesSimd(bytes,new Uint8Array(3)),false);
+    } finally {WebAssembly.Module=original;}
+});
