+import {byteEqualityBytes} from './sharedAxisByteEqualityBytes.js';
+
+// One bounded synchronous workspace. Inputs and saved snapshots remain owned
+// by their caller; the byte comparison never changes either array.
+const chunkBytes=256*1024;
+let kernel,buffer,unavailable=false;
+export function sameBytesSimd(a,b) {
+    if(a.byteLength!==b.byteLength)return false;
+    if(unavailable)return null;
+    if(!kernel) {
+        try {
+            const memory=new WebAssembly.Memory({initial:8,maximum:8});
+            kernel=new WebAssembly.Instance(new WebAssembly.Module(byteEqualityBytes),{env:{memory}}).exports;
+            buffer=new Uint8Array(memory.buffer);
+        } catch {unavailable=true;return null;}
+    }
+    for(let offset=0;offset<a.byteLength;offset+=chunkBytes) {
+        const end=Math.min(a.byteLength,offset+chunkBytes);
+        buffer.set(a.subarray(offset,end),0);buffer.set(b.subarray(offset,end),chunkBytes);
+        if(!kernel.same(0,chunkBytes,end-offset))return false;
+    }
+    return true;
+}
