+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {nativeHingeTorqueTangent} from '../src/physics/kirchhoffSharedAxisMaterialTangent.js';
+import {quaternionExp} from '../src/physics/discreteKirchhoffRod.js';
+import {sharedAxisMaterialKernelBytes} from '../src/physics/kirchhoffSharedAxisMaterialKernelBytes.js';
+
+test('batched constitutive preparation matches every scalar of the original torque and derivative inputs',()=>{
+    const count=1200,pages=Math.ceil((count+1)*728/65536),memory=new WebAssembly.Memory({initial:pages,maximum:pages});
+    const wasm=new WebAssembly.Instance(new WebAssembly.Module(sharedAxisMaterialKernelBytes),
+        {env:{memory,sin:Math.sin,cos:Math.cos,atan2:Math.atan2,pow:Math.pow}}).exports;
+    const expected=[];
+    for(let index=0;index<count;index++) {
+        const magnitude=[0,1e-10,.01,.1,.3,1,2.8][index%7];
+        const q0=quaternionExp({x:magnitude*Math.sin(index+.3),y:magnitude*Math.cos(index+.4),z:.2*magnitude});
+        const q1=quaternionExp({x:magnitude*Math.cos(index+.7),y:magnitude*Math.sin(index+.2),z:-.3*magnitude});
+        if(index%3===0)for(const k of ['x','y','z','w'])q1[k]=-q1[k];
+        const rest={x:magnitude*.2,y:magnitude*.1,z:magnitude*-.3},rq=quaternionExp(rest);
+        const compliance=[1e-8*(1+index),.01*(1+index),1+index];
+        const gold=new Float64Array(91);
+        nativeHingeTorqueTangent(q0,q1,rest,compliance,true,null,gold);
+        expected.push(gold.slice(44));
+        const record=new Float64Array(memory.buffer,index*728,91);record.fill(NaN);
+        record.set([q0.x,q0.y,q0.z,q0.w,q1.x,q1.y,q1.z,q1.w,rq.x,rq.y,rq.z,rq.w]);
+        record.set(gold.subarray(77,86),77);record.set(compliance,86);
+        for(let i=0;i<3;i++)for(let j=0;j<3;j++)record[12+i*3+j]=gold[77+j*3+i];
+    }
+    const untouched=new Float64Array(memory.buffer,count*728,91);untouched.fill(17);
+    wasm.prepareMaterials(0,count);
+    for(let index=0;index<count;index++) {
+        const actual=new Float64Array(memory.buffer,index*728+44*8,47);
+        assert.deepEqual(actual,expected[index],`record ${index}`);
+    }
+    assert.ok(untouched.every(v=>v===17));
+    wasm.prepareMaterials(0,0);assert.ok(untouched.every(v=>v===17));
