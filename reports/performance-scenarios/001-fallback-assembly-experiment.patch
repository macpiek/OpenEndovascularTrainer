+++ b/tests/kirchhoffSharedAxisFallbackAssembly.test.js
@@ -0,0 +1,82 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createSharedAxisNative,assembleSharedAxisNative,applySharedAxisNativeIncrement} from '../src/physics/kirchhoffSharedAxisNative.js';
+import {prepareSharedAxisDynamicStep} from '../src/physics/kirchhoffSharedAxisDynamics.js';
+import {createSharedAxisConstraintRowPool} from '../src/physics/kirchhoffSharedAxisConstraintRows.js';
+
+function fixture(wallSamples=[]) {
+    const state=createSharedAxisNative({tools:[{id:'wire',insertion:55.2},{id:'catheter',type:'pigtail',insertion:42.7}],
+        wallSamples,samplePosition:x=>[80*Math.sin(x/80),80*(1-Math.cos(x/80)),.03*x]});
+    state.cacheMechanicalAssembly=true;state.loads[state.layout.dofCount-1]=.123;
+    let reads=0;
+    const body=state.materials[0].body,rest=body.restRotation1;
+    Object.defineProperty(body,'restRotation1',{get(){reads++;return rest;}});
+    return {state,pool:createSharedAxisConstraintRowPool(),reads:()=>reads};
+}
+function measure(f,reuseFallbackAssembly,options={}) {
+    const s=f.state,m=assembleSharedAxisNative(s,{reuseFallbackAssembly,rowStorage:f.pool.acquire(),reuseConstraintWork:true,...options});
+    return {energy:m.energy,force:m.force,torque:m.torque,constraint:m.constraint,
+        gradient:s.chain.gradient.slice(),hessian:s.chain.hessian.slice(),tangent:s.chain.tangent?.slice(),
+        rows:m.rows.map(r=>({gap:r.gap,multiplier:r.multiplier,jacobian:r.jacobian.slice(),hessian:r.geometricHessian?.slice()}))};
+}
+for(const wasmMaterial of [false,true])test(`two tangent caches retain fresh-versus-reused arithmetic and exact physical rows (WASM=${wasmMaterial})`,()=>{
+    const reference=fixture(),actual=fixture();
+    const compare=options=>assert.deepEqual(measure(actual,true,{wasmMaterial,...options}),measure(reference,false,{wasmMaterial,...options}));
+    for(const f of [reference,actual])prepareSharedAxisDynamicStep(f.state,1/60);
+    compare({tangentMode:'newton'});compare({tangentMode:'gauss-newton'});
+    const before=actual.reads(),refBefore=reference.reads();
+    compare({tangentMode:'newton'});
+    assert.equal(actual.reads(),before,'Returning to the same Newton pose must reuse material work');
+    assert.ok(reference.reads()>refBefore);
+    compare({tangentMode:'gauss-newton'});
+    for(const f of [reference,actual])f.state.loads[f.state.loads.length-1]=-.031;
+    const beforeLoadChange=actual.reads();
+    compare({tangentMode:'newton'});
+    assert.ok(actual.reads()>beforeLoadChange,'A fresh gradient for different loads cannot be reused');
+    const owned=new Set([actual.state.mechanicalAssemblyCache,actual.state.mechanicalAssemblyCache.alternate]);
+    for(let turn=0;turn<8;turn++) {
+        for(const f of [reference,actual])f.state.multipliers.fill(turn*.1);
+        compare({tangentMode:turn%2?'newton':'gauss-newton'});compare({tangentMode:turn%2?'newton':'gauss-newton'});
+        assert.ok(owned.has(actual.state.mechanicalAssemblyCache));
+        assert.ok(owned.has(actual.state.mechanicalAssemblyCache.alternate));
+        assert.equal(actual.state.mechanicalAssemblyCache.alternate.alternate,undefined,'Only two records may be retained');
+    }
+    // Changed loads, inertia targets and physical pose cannot reuse an older
+    // fresh gradient, even when it belongs to the requested tangent variant.
+    for(let turn=0;turn<3;turn++) {
+        for(const f of [reference,actual]) {
+            const s=f.state;s.loads[s.loads.length-1]=turn%2?-.013:0;s.loads[0]=-0;
+            prepareSharedAxisDynamicStep(s,turn%2?1/120:1/60);
+            applySharedAxisNativeIncrement(s,Float64Array.from({length:s.layout.dofCount},(_,i)=>.0001*Math.sin(i+turn)),new Float64Array(s.multipliers.length));
+        }
+        compare({tangentMode:'gauss-newton'});compare({tangentMode:'newton'});
+        compare({tangentMode:'newton',withTangent:false});compare({tangentMode:'gauss-newton'});compare({tangentMode:'newton'});
+    }
+});
+
+test('a topology restart preserves deferred cache rounding when revisiting another tangent',()=>{
+    const sample=()=>({gap:1,jacobian:[0,0,0,0,0,0]});
+    sample.sharedAxisGeometryOnly=true;sample.sharedAxisDiscovery=true;
+    const reference=fixture([sample]),actual=fixture([sample]);
+    const compare=tangentMode=>assert.deepEqual(measure(actual,true,{tangentMode,earlyContactPreflight:true}),measure(reference,false,{tangentMode,earlyContactPreflight:true}));
+    compare('newton');compare('gauss-newton');
+    for(const [f,enabled] of [[actual,true],[reference,false]]) {
+        f.state.pendingVesselRows=new Map([['pending',{}]]);
+        assert.throws(()=>measure(f,enabled,{tangentMode:'newton',earlyContactPreflight:true}),/shared-axis-wall-discovery/);
+        assert.equal(f.state.mechanicalAssemblyCache.deferred,true);
+        f.state.pendingVesselRows.clear();
+    }
+    compare('newton');compare('gauss-newton');compare('newton');
+});
+
+test('external potentials retain their original callback order and single-cache semantics',()=>{
+    const make=()=>{let calls=0;const sample=()=>({gap:1,jacobian:[0,0,0,0,0,0]});
+        sample.addPotential=s=>{calls++;s.chain.gradient[s.layout.dofCount-1]+=.001;return .002;};
+        return {...fixture([sample]),calls:()=>calls};};
+    const actual=make(),reference=make();
+    for(const tangentMode of ['newton','gauss-newton','newton','newton','gauss-newton']) {
+        assert.deepEqual(measure(actual,true,{tangentMode}),measure(reference,false,{tangentMode}));
+        assert.equal(actual.calls(),reference.calls());
+        assert.equal(actual.state.mechanicalAssemblyCache.alternate,undefined);
+    }
+});
