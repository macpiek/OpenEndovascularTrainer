+// Private to a single whole-step attempt, including all recovery paths.
+// No observation callbacks or retained solver arrays: profiling must not
+// disable caches, materialize deferred rows or change the physical search.
+export const directionProfileLease=Symbol('shared-axis-direction-profile');
+export function recordSharedAxisDirection(profile,method,direction) {
+    if(!profile)return;
+    const status=direction?direction.converged?'solved':direction.failure??'residual':'reused-rejection';
+    const key=`${method}/${status}`;
+    const item=profile[key]??={calls:0,attempts:0,factorizations:0,maximumAttempts:0};
+    item.calls++;item.attempts+=direction?.activeSetAttempts??0;
+    item.factorizations+=direction?.factorizations??0;
+    item.maximumAttempts=Math.max(item.maximumAttempts,direction?.activeSetAttempts??0);
+}
