+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createBandPrefixProfile,withBandPrefixProfile,recordPreparedBandPrefix} from '../src/physics/kirchhoffBandPrefixProfile.js';
+const data=()=>({factor:new Float64Array(600*7).fill(2),rhs:new Float64Array(600).fill(1),right:Int32Array.from({length:600},(_,i)=>Math.min(599,i+2))});
+const record=d=>recordPreparedBandPrefix(d.factor,d.rhs,d.right,600,7,2,2);
+test('prefix eligibility includes the RHS, signed zero, row bounds and full pivot reach',()=>{
+    const p=createBandPrefixProfile(),d=data();withBandPrefixProfile(p,()=>{
+        record(d);d.rhs[400]=3;record(d);
+        assert.equal(p.report.safePrefixColumns,398);
+        d.factor[300*7]=-0;record(d);
+        assert.equal(p.report.safePrefixColumns,398+298);
+        d.factor[300*7]=0;record(d);
+        assert.equal(p.report.safePrefixColumns,398+298*2);
+        d.right[200]++;record(d);
+        assert.equal(p.report.safePrefixColumns,398+298*2+198);
+    });assert.equal(p.report.calls,5);
+});
+test('profile scopes restore on nested calls, suspension and throw; numerical input remains owned by the caller',()=>{
+    const a=createBandPrefixProfile(),b=createBandPrefixProfile(),d=data(),saved=structuredClone(d);
+    withBandPrefixProfile(a,()=>{record(d);withBandPrefixProfile(b,()=>record(d));record(d);});
+    record(d);assert.equal(a.report.calls,2);assert.equal(b.report.calls,1);
+    assert.throws(()=>withBandPrefixProfile(a,()=>{throw new Error('cancel');}));record(d);
+    assert.equal(a.report.calls,2);assert.deepEqual(d,saved);
+    d.rhs.fill(4);assert.equal(a.previous.rhs[0],1);assert.equal(b.previous.rhs[0],1);
+});
