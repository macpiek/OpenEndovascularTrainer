@@ -0,0 +1,28 @@
+import fs from 'node:fs';
+import {gunzipSync} from 'node:zlib';
+import {createHash} from 'node:crypto';
+import {loadCoupledRuntimeAnatomy} from '../tests/helpers/coupledRuntimeFixture.js';
+import {createCrossoverFlow} from '../tests/helpers/crossoverFlow.js';
+import {compareCrossoverAlternative,summarizeAlternative} from '../src/benchmark/crossoverAlternativeSolvers.js';
+
+const input='reports/performance-scenarios/003-crossover-full-user-inputs.json.gz';
+const solver=process.argv[2]??'xpbd',options=JSON.parse(process.argv[3]??'{}');
+const output=process.argv[4]??`reports/performance-scenarios/012-${solver}-screen.json`;
+const bytes=fs.readFileSync(input),record=JSON.parse(gunzipSync(bytes));
+const anatomy=await loadCoupledRuntimeAnatomy(undefined,record.configuration.anatomy),rows=[];
+const report={solver,options,input,sourceSha256:createHash('sha256').update(bytes).digest('hex'),startedAt:new Date().toISOString(),
+    sourceHashes:Object.fromEntries(['src/physics/sharedAxisXpbdExperimental.js','src/physics/kirchhoffSharedAxisProjective.js',
+        'src/benchmark/crossoverAlternativeSolvers.js'].map(p=>[p,createHash('sha256').update(fs.readFileSync(p)).digest('hex')])),
+    scope:'CPU screening of full recorded targets from empty tools, right access only; not full-app FPS. Stops on geometry rejection, continues through shape-budget failures for diagnosis.',
+    defaultSolverChanged:false,rows};
+try {
+    for(const row of compareCrossoverAlternative({record,field:anatomy.field,flow:createCrossoverFlow(),solver,options})) {
+        rows.push(row);
+        if(row.step%300===0||!row.accepted)console.log(JSON.stringify({step:row.step,status:row.status,cpuMs:row.cpuMs,
+            differenceMm:row.shapeDifferenceMm,attempts:!row.accepted?row.attempts:undefined}));
+    }
+}catch(error){report.error=error.stack;process.exitCode=1;}
+finally {
+    report.summary=summarizeAlternative(rows,record.steps.length);report.finishedAt=new Date().toISOString();
+    fs.writeFileSync(output,JSON.stringify(report,null,2)+'\n');anatomy.dispose();console.log(JSON.stringify(report.summary));
+}
diff --git a/scripts/validate-crossover-alternative.mjs b/scripts/validate-crossover-alternative.mjs
new file mode 100644
index 0000000..72cf6ce
--- /dev/null
+++ b/scripts/validate-crossover-alternative.mjs
@@ -0,0 +1,39 @@
+// Independent coverage/metric audit of REJECTED research runs. These reports
+// do not carry full candidate poses and cannot certify whole-trajectory shape.
+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+import {gunzipSync} from 'node:zlib';
+import {createHash} from 'node:crypto';
+import {summarizeAlternative} from '../src/benchmark/crossoverAlternativeSolvers.js';
+const [candidatePath,outputPath]=process.argv.slice(2);
+assert.ok(candidatePath&&outputPath,'Provide candidate and output paths');
+const referencePath='reports/performance-scenarios/003-crossover-full-user-inputs.json.gz';
+const bytes=fs.readFileSync(referencePath),decoded=gunzipSync(bytes),reference=JSON.parse(decoded);
+const candidateBytes=fs.readFileSync(candidatePath),candidate=JSON.parse(candidateBytes);
+const hash=b=>createHash('sha256').update(b).digest('hex');
+assert.equal(hash(bytes),'bf2067e132ee933e052f39c4a68ba8d1f7e0c2fada445cedc86177a70324dbac');
+assert.ok([hash(bytes),hash(decoded)].includes(candidate.sourceSha256));
+assert.ok(candidate.rows.length<=reference.steps.length);
+for(const [i,row] of candidate.rows.entries()) {
+    assert.equal(row.step,i+1);assert.deepEqual(row.tools,reference.steps[i].tools);
+    for(const key of ['stage','moving'])assert.deepEqual(row[key],reference.steps[i][key]);
+    assert.ok(Number.isFinite(row.cpuMs)&&row.cpuMs>=0);
+    if(row.accepted) {
+        assert.equal(row.quality.finite,true);assert.ok(row.quality.maxPenetration<=1e-5);
+        assert.ok(row.quality.bodies.every(b=>b.maxLengthError<=1e-5));
+        assert.ok(Number.isFinite(row.shapeDifferenceMm)&&row.shapeDifferenceMm>=0);
+        assert.equal(row.shapeWithinLimit,row.shapeDifferenceMm<=1);
+        if(row.xpbd?.maxLengthErrorMm!==undefined)assert.ok(row.xpbd.maxLengthErrorMm<=1e-5);
+    } else assert.equal(i,candidate.rows.length-1,'No inputs consumed after rejection');
+}
+const summary=summarizeAlternative(candidate.rows,reference.steps.length);
+const report={reference:referencePath,candidate:candidatePath,referenceSha256:hash(bytes),referenceDecodedSha256:hash(decoded),
+    candidateSha256:hash(candidateBytes),rightAccessTargetPrefixVerified:true,stepsChecked:candidate.rows.length,
+    expectedSteps:reference.steps.length,summary,
+    observedWallThroughputHz:candidate.wallMs?summary.acceptedSteps*1000/candidate.wallMs:null,
+    physicalForceCertificate:false,completeCommonStepReplay:false,goalAchieved:false,
+    limitations:['Research harness directly applies recorded right-access targets, not the app input handler or both accesses.',
+        'Shape errors were measured by the running harness; candidate polylines are not included for independent recomputation.',
+        'CPU capacity and the simple browser test are not full-application physics FPS.',
+        'Incomplete/rejected trajectories cannot pass optimization acceptance.']};
+fs.writeFileSync(outputPath,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(summary));
diff --git a/tests/sharedAxisXpbdExperimental.test.js b/tests/sharedAxisXpbdExperimental.test.js
new file mode 100644
index 0000000..bfd336e
--- /dev/null
+++ b/tests/sharedAxisXpbdExperimental.test.js
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {Quaternion,Vector3} from 'three';
+import {createSharedAxisNative,captureSharedAxisNative} from '../src/physics/kirchhoffSharedAxisNative.js';
+import {iterateSharedAxisXpbd,xpbdVectorIncrement} from '../src/physics/sharedAxisXpbdExperimental.js';
+
+const finish=it=>{let n;do{n=it.next();}while(!n.done);return n.value;};
+const create=extra=>createSharedAxisNative({tools:[{id:'catheter',type:'straight',insertion:60}],...extra});
+const close=(a,b,e=1e-9)=>assert.ok(Math.abs(a-b)<=e,`${a} vs ${b}`);
+const I=Float64Array.from([1,0,0,0,1,0,0,0,1]);
+
+test('XPBD local block matches analytical compliant spring and accumulates lambda only once',()=>{
+    for(const dt of [1/30,1/60,1/120]) {
+        const x=[1,2,3],alpha=[.01,.02,.03],lambda=[0,0,0];
+        const delta=xpbdVectorIncrement(x,lambda,alpha,dt,[I],[.5]);
+        delta.forEach((v,k)=>close(v,-x[k]/(.5+alpha[k]/dt**2)));
+        const next=x.map((v,k)=>v+.5*delta[k]);
+        const repeat=xpbdVectorIncrement(next,delta,alpha,dt,[I],[.5]);
+        repeat.forEach(x=>close(x,0));
+    }
+});
+
+test('XPBD unloaded straight rod remains at rest and does not claim Newton certification',()=>{
+    const s=create(),before=captureSharedAxisNative(s),result=finish(iterateSharedAxisXpbd(s,1/60));
+    assert.equal(result.converged,true,JSON.stringify(result));
+    assert.equal(result.certificateBound,undefined);assert.equal(result.xpbd.equilibriumCertified,false);
+    s.positions.forEach((p,i)=>p.forEach((v,k)=>close(v,before.positions[i][k])));
+    assert.equal(result.factorizations,0);
+});
+
+test('XPBD cancellation and rejected geometry restore the complete incoming pose and dynamics',()=>{
+    const s=create({tools:[{id:'catheter',type:'berenstein',insertion:60}]}),before=captureSharedAxisNative(s);
+    s.velocities=s.positions.map(()=>[0,.1,0]);const velocities=s.velocities;
+    s.wallFrictionHistory=[{id:'original'}];const history=s.wallFrictionHistory;
+    const it=iterateSharedAxisXpbd(s,1/60);assert.equal(it.next().done,false);it.return();
+    assert.deepEqual(captureSharedAxisNative(s),before);assert.equal(s.velocities,velocities);assert.equal(s.wallFrictionHistory,history);
+    const result=finish(iterateSharedAxisXpbd(s,1/60,{xpbd:{iterations:1,maxShear:1e-14,maxLengthError:1e-14}}));
+    assert.equal(result.converged,false);assert.deepEqual(captureSharedAxisNative(s),before);assert.equal(s.dynamicStep,null);
+});
+
+test('intrinsic bend responds to rotating the manufactured material frame',()=>{
+    const poses=[];
+    for(const angle of [0,Math.PI/2]) {
+        const s=create({tools:[{id:'catheter',type:'berenstein',insertion:60,shaftStiffness:2,tipStiffness:2}]});
+        const rotation=new Quaternion().setFromAxisAngle(new Vector3(1,0,0),angle);
+        for(const {body,last} of s.materials)for(let e=0;e<last;e++) {
+            const q=new Quaternion(body.orientationX[e],body.orientationY[e],body.orientationZ[e],body.orientationW[e]).premultiply(rotation);
+            for(const k of ['X','Y','Z','W'])body['orientation'+k][e]=q[k.toLowerCase()];
+        }
+        // Loose gates measure covariance of the method, not clinical accuracy.
+        for(let step=0;step<10;step++)assert.equal(finish(iterateSharedAxisXpbd(s,1/60,
+            {xpbd:{iterations:64,maxShear:.01,maxLengthError:.01}})).converged,true);
+        poses.push(s.positions.at(-1));
+    }
+    assert.ok(Math.hypot(poses[0][1],poses[0][2])>.01);
+    const rotated=new Vector3(...poses[0]).applyAxisAngle(new Vector3(1,0,0),Math.PI/2).toArray();
+    rotated.forEach((v,k)=>close(v,poses[1][k],1e-7));
+});
+
+test('hard wall remains unilateral and fixed inlet positions cannot move',()=>{
+    const s=create({wallSample:({b})=>({gap:.5-b[1],jacobian:[0,0,0,0,-1,0]})});
+    const before=s.positions.slice(0,2).map(p=>p.slice());
+    s.velocities=s.positions.map((_,i)=>[0,i>1?60:0,0]);
+    const r=finish(iterateSharedAxisXpbd(s,1/60,{xpbd:{iterations:128,maxShear:.1,maxLengthError:.1}}));
+    assert.equal(r.converged,true,JSON.stringify(r));assert.ok(r.quality.maxPenetration<=1e-5);
+    assert.deepEqual(s.positions.slice(0,2),before);assert.ok(s.multipliers.every(x=>x>=0));
+    assert.ok(Math.max(...s.multipliers)>0);
+});
+
+test('invalid timestep and iteration budget are rejected before changing state',()=>{
+    const s=create(),before=captureSharedAxisNative(s);
+    for(const [dt,xpbd] of [[0,{}],[NaN,{}],[1/60,{iterations:1.5}]])
+        assert.throws(()=>finish(iterateSharedAxisXpbd(s,dt,{xpbd})),/Invalid XPBD/);
+    assert.deepEqual(captureSharedAxisNative(s),before);
+});
+
+test('hybrid global closure measures its correction without disguising it as force convergence',()=>{
+    const s=create({tools:[{id:'catheter',type:'berenstein',insertion:60}]});
+    const before=s.positions.slice(0,2).map(p=>p.slice());
+    const r=finish(iterateSharedAxisXpbd(s,1/60,{xpbd:{iterations:8,hardClosure:true}}));
+    assert.equal(r.converged,true,JSON.stringify(r));assert.ok(r.xpbd.closureCorrectionMm>0);
+    assert.ok(r.xpbd.preClosureShear>r.xpbd.maxShear);assert.ok(r.xpbd.maxShear<=1e-5);
+    assert.ok(r.xpbd.maxLengthErrorMm<=1e-5);assert.equal(r.xpbd.equilibriumCertified,false);
+    assert.deepEqual(s.positions.slice(0,2),before);
+});
