+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {sharedAxisStepAccuracy} from '../src/physics/kirchhoffSharedAxisAppSystem.js';
+test('accuracy selection is explicit, restricted to both long research tools, immutable and reversible',()=>{
+ const base={forceTolerance:1e-6,lengthTolerance:1e-5};
+ const options={...base,longInsertionForceThresholdMm:400};
+ const tools=[{id:'wire',type:'glidewire',insertion:600},{id:'catheter',type:'pigtail',insertion:400}];
+ assert.equal(sharedAxisStepAccuracy(base,tools),base);
+ const relaxed=sharedAxisStepAccuracy(options,tools);assert.equal(relaxed.forceTolerance,1e-4);assert.equal(relaxed.lengthTolerance,1e-5);
+ for(const variant of [[{...tools[0],insertion:399},tools[1]],[tools[0],{...tools[1],insertion:399}],[tools[0]],[tools[0],{...tools[1],type:'stentgraft-delivery'}],[{...tools[0],insertion:Infinity},tools[1]]])assert.equal(sharedAxisStepAccuracy(options,variant),options);
+ assert.deepEqual(options,{...base,longInsertionForceThresholdMm:400});assert.equal(tools[1].insertion,400);
+ for(const threshold of [0,399,NaN,Infinity])assert.throws(()=>sharedAxisStepAccuracy({...base,longInsertionForceThresholdMm:threshold},tools));
+});
