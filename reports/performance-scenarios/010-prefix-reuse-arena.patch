+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createKirchhoffLinearKernel} from '../src/physics/kirchhoffLinearKernel.js';
+import {solveBandWithPrefix,getBandPrefixReuseStats} from '../src/physics/kirchhoffBandPrefixReuse.js';
+function workspace(n,kl,ku,simd=true) {
+    const stride=2*kl+ku+1,bytes=8*n*stride+16*n+1024,kernel=createKirchhoffLinearKernel(3*bytes,{simd});
+    const w={n,kl,ku,stride,kernel,factor:kernel.alloc(Float64Array,n*stride),rhs:kernel.alloc(Float64Array,n),right:kernel.alloc(Int32Array,n)};
+    const cache=kernel.alloc(Uint8Array,2*bytes);kernel.prefixStorage={offset:cache.byteOffset,bytes:cache.byteLength};
+    return w;
+}
+function input(w,tail=0,mode='ordinary') {
+    const {n,kl,ku,stride,factor,rhs,right}=w;factor.fill(0);
+    for(let i=0;i<n;i++) {
+        right[i]=Math.min(n-1,i+ku);rhs[i]=Math.cos(i)*.3+(i>n-15?tail:0);
+        for(let j=Math.max(0,i-kl);j<=right[i];j++)factor[i*stride+kl+j-i]=
+            i===j?(mode==='pivot'?.00001:5+kl+ku)+(i>n-15?tail:0):Math.sin(i*7+j*11)*.4;
+    }
+    if(mode==='singular-prefix')for(let i=0;i<n;i++)for(let j=Math.max(0,i-kl);j<=right[i];j++)if(j===11)factor[i*stride+kl+j-i]=0;
+    if(mode==='singular-suffix')for(let i=0;i<n;i++)for(let j=Math.max(0,i-kl);j<=right[i];j++)if(j===n-10)factor[i*stride+kl+j-i]=0;
+}
+function compare(w,change=()=>{}) {
+    change(w);const ref=workspace(w.n,w.kl,w.ku,false);
+    ref.factor.set(w.factor);ref.rhs.set(w.rhs);ref.right.set(w.right);
+    const result=solveBandWithPrefix(w.kernel,w.factor,w.rhs,w.right,w.n,w.kl,w.ku);
+    const expected=ref.kernel.solveGeneralBandLU(ref.factor.byteOffset,ref.rhs.byteOffset,ref.right.byteOffset,ref.n,ref.kl,ref.ku);
+    assert.equal(result,expected);assert.deepEqual(w.factor,ref.factor);assert.deepEqual(w.rhs,ref.rhs);assert.deepEqual(w.right,ref.right);
+    return result;
+}
+test('cached elimination matches scalar pivoting and backsolve exactly, including changed tail equations and failures',()=>{
+    const start=getBandPrefixReuseStats();
+    for(const [n,kl,ku] of [[220,5,7],[420,9,4],[801,13,8]]) {
+        const w=workspace(n,kl,ku);
+        for(const mode of ['ordinary','pivot','singular-suffix','ordinary','singular-prefix','ordinary']) {
+            for(const tail of [0,.03,.05]){input(w,tail,mode);compare(w);}
+        }
+    }
+    const end=getBandPrefixReuseStats();assert.ok(end.hits-start.hits>=15);assert.ok(end.columnsSkipped>start.columnsSkipped);
+});
+test('RHS, pivot-frontier and layout changes invalidate the prefix; interleaved owners cannot corrupt retained data',()=>{
+    const w=workspace(850,11,5),other=workspace(211,3,7);
+    input(w);compare(w);let hits=getBandPrefixReuseStats().hits;
+    input(w,.03);compare(w);assert.equal(getBandPrefixReuseStats().hits,hits+1);hits++;
+    input(w,.05);compare(w,x=>x.rhs[522]+=.001);assert.equal(getBandPrefixReuseStats().hits,hits);
+    input(other);compare(other);input(w,.08);compare(w);assert.equal(getBandPrefixReuseStats().hits,hits);
+    const grown=workspace(851,11,5);input(grown,.09);compare(grown);assert.equal(getBandPrefixReuseStats().hits,hits);
+    input(grown,.09);compare(grown);assert.equal(getBandPrefixReuseStats().hits,hits+1);
+    // The full band bounds, not just coefficients, affect pivot fill.
+    input(grown,.1);compare(grown,x=>{x.right[520]--;x.factor[520*x.stride+x.kl+5]=0;});
+    assert.equal(getBandPrefixReuseStats().hits,hits+1);
+});
+test('unsupported SIMD and tiny systems retain ordinary exact elimination',()=>{
+    for(const [n,simd] of [[40,true],[850,false]]){const w=workspace(n,7,3,simd);input(w,0,'pivot');compare(w);}
+});
