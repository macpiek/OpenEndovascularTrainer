+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {factorProjectiveBand} from '../src/physics/projectiveRodMath.js';
+
+test('three-component band solves are bit-identical and own their outputs across sizes and fixed supports',()=>{
+    for(const count of [1,5,33,199,1400])for(const reach of [1,4,9]) {
+        const terms=Array.from({length:count},(_,i)=>({ids:[i],coefficients:[1],weight:2+Math.abs(Math.sin(i))}));
+        for(let i=0;i<count;i++)for(let j=i+1;j<Math.min(count,i+reach);j++)
+            terms.push({ids:[i,j],coefficients:[-1,1+.1*Math.cos(j)],weight:.3+Math.abs(Math.sin(i+j))});
+        const fixed=new Map([[0,[1,-2,3]],...(count>5?[[3,[-2,0,0]]]:[])]);
+        const rhs=Array.from({length:count},(_,i)=>[Math.sin(i*.12),-0,Math.cos(i*.03)]);
+        const slow=factorProjectiveBand(terms,count,fixed),fast=factorProjectiveBand(terms,count,fixed,{vectorSolve:true});
+        const expected=slow.solve(rhs),actual=fast.solve(rhs);
+        assert.deepEqual(actual,expected);
+        const saved=structuredClone(actual);fast.solve(rhs.map(p=>p.map(v=>v*2)));
+        assert.deepEqual(actual,saved);assert.notEqual(actual[0],fixed.get(0));
+        assert.deepEqual(rhs[0],[0,-0,1]);
+    }
+});
