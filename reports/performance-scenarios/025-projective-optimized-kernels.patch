+// Solve the same scalar Cholesky factor for three RHS components together.
+// Each component retains its original subtraction/division order. Interleave
+// only independent axes so band indices and coefficients are loaded once.
+// Returned arrays are owned by the caller, including prescribed vectors.
+export function solveProjectiveBandVector(a,band,count,fixed,offset,rhs) {
+    const x=rhs.map((p,i)=>fixed.has(i)?fixed.get(i).slice():p.map((v,k)=>v+offset[i][k]));
+    for(let i=0;i<count;i++) {
+        const p=x[i],at=i*band,diagonal=a[at];
+        let x0=p[0],x1=p[1],x2=p[2];
+        for(let j=Math.max(0,i-band+1);j<i;j++) {
+            const coefficient=a[at+i-j],q=x[j];
+            x0-=coefficient*q[0];x1-=coefficient*q[1];x2-=coefficient*q[2];
+        }
+        p[0]=x0/diagonal;p[1]=x1/diagonal;p[2]=x2/diagonal;
+    }
+    for(let i=count-1;i>=0;i--) {
+        const p=x[i],diagonal=a[i*band];
+        let x0=p[0],x1=p[1],x2=p[2];
+        for(let j=i+1;j<Math.min(count,i+band);j++) {
+            const coefficient=a[j*band+j-i],q=x[j];
+            x0-=coefficient*q[0];x1-=coefficient*q[1];x2-=coefficient*q[2];
+        }
+        p[0]=x0/diagonal;p[1]=x1/diagonal;p[2]=x2/diagonal;
+    }
+    return x;
+}
