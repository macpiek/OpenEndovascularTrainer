+// Research-only chord tangent for elastic material terms. The caller still
+// evaluates the current residual, inertia, wall geometry and friction. This
+// context belongs to one nonlinear solve, never to a shared/global cache.
+const parameters = ['restRotation1','restRotation2','restRotation3',
+    'kirchhoffBendCompliance1','kirchhoffBendCompliance2','kirchhoffTwistCompliance'];
+const orientations = ['orientationX','orientationY','orientationZ','orientationW'];
+
+export function createSharedAxisElasticReuse({maxAge=1,positionBudgetMm=.05,frameBudget=.002}={}) {
+    if(!Number.isInteger(maxAge)||maxAge<1||!(positionBudgetMm>0)||!Number.isFinite(positionBudgetMm)||
+        !(frameBudget>0)||!Number.isFinite(frameBudget))throw new RangeError('Invalid elastic reuse limits');
+    let saved=null,age=0;
+    const diagnostics={elasticFresh:0,elasticReused:0};
+    const invalidate=()=>{saved=null;age=0;};
+    function matches(s) {
+        if(!saved||age>=maxAge||saved.layout!==s.layout||saved.materials!==s.materials||
+            saved.positions.length!==s.positions.length)return false;
+        for(let i=0;i<s.positions.length;i++) {
+            let distance=0;
+            for(let k=0;k<3;k++)distance+=(s.positions[i][k]-saved.positions[i][k])**2;
+            if(!(distance<=positionBudgetMm**2))return false;
+        }
+        for(let t=0;t<s.materials.length;t++) {
+            const {body,last}=s.materials[t],old=saved.bodies[t];
+            if(old.body!==body||old.last!==last)return false;
+            for(const key of parameters)for(let i=1;i<last;i++)
+                if(!Object.is(body[key][i],old[key][i]))return false;
+            for(const key of orientations)for(let i=0;i<last;i++)
+                if(!(Math.abs(body[key][i]-old[key][i])<=frameBudget))return false;
+        }
+        return true;
+    }
+    return {diagnostics,invalidate,
+        assemble(s,evaluate) {
+            if(matches(s)) {
+                // evaluate(false) must recompute current energy and forces.
+                const energy=evaluate(false);
+                s.chain.tangent.set(saved.tangent);
+                age++;diagnostics.elasticReused++;
+                return energy;
+            }
+            const energy=evaluate(true);
+            diagnostics.elasticFresh++;
+            saved={layout:s.layout,materials:s.materials,positions:s.positions.map(p=>p.slice()),
+                tangent:s.chain.tangent.slice(),bodies:s.materials.map(({body,last})=>({body,last,
+                    ...Object.fromEntries([...parameters,...orientations].map(key=>[key,body[key].slice(0,last)]))}))};
+            age=0;
+            return energy;
+        }
+    };
+}
