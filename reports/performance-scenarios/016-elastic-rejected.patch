+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createSharedAxisElasticReuse} from '../src/physics/kirchhoffSharedAxisElasticReuse.js';
+import {assembleSharedAxisMaterialTangent} from '../src/physics/kirchhoffSharedAxisMaterialTangent.js';
+import {createSharedAxisNative,applySharedAxisNativeIncrement,assembleSharedAxisNative,relaxSharedAxisNative} from '../src/physics/kirchhoffSharedAxisNative.js';
+
+const state=()=>createSharedAxisNative({tools:[{id:'wire',insertion:60},{id:'catheter',insertion:45,type:'pigtail'}],
+    samplePosition:x=>[200*Math.sin(x/200),200*(1-Math.cos(x/200)),.01*x]});
+const move=s=>applySharedAxisNativeIncrement(s,Float64Array.from({length:s.layout.dofCount},(_,i)=>.00001*Math.sin(i)),new Float64Array(s.multipliers.length));
+for(const wasm of [false,true])test(`elastic chord retains fresh forces, owns tangent and refreshes after one reuse (WASM=${wasm})`,()=>{
+    const s=state(),reuse=createSharedAxisElasticReuse();
+    assembleSharedAxisMaterialTangent(s,true,null,wasm,true,reuse);
+    const old=s.chain.tangent.slice(),oldGradient=s.chain.gradient.slice();
+    move(s);s.loads[15]+=.002;
+    const energy=assembleSharedAxisMaterialTangent(s,true,null,wasm,true,reuse),gradient=s.chain.gradient.slice();
+    assert.deepEqual(reuse.diagnostics,{elasticFresh:1,elasticReused:1});
+    assert.deepEqual(s.chain.tangent,old);
+    assert.notDeepEqual(gradient,oldGradient);
+    assert.equal(assembleSharedAxisMaterialTangent(s,true,null,wasm,true),energy);
+    assert.deepEqual(s.chain.gradient,gradient,'current loads and elastic forces must remain exact');
+    assert.notDeepEqual(s.chain.tangent,old,'pose changed the exact tangent');
+    const exact=s.chain.tangent.slice();
+    assembleSharedAxisMaterialTangent(s,true,null,wasm,true,reuse);
+    assert.deepEqual(s.chain.tangent,exact);
+    assert.deepEqual(reuse.diagnostics,{elasticFresh:2,elasticReused:1});
+});
+
+test('elastic reuse invalidates on position, frame, constitutive and material identity changes',()=>{
+    for(const change of [s=>s.positions[5][1]+=.1,s=>s.materials[0].body.orientationZ[3]+=.01,
+        s=>s.materials[0].body.restRotation1[3]+=.01,s=>s.materials[0].body.kirchhoffBendCompliance1[3]*=2,
+        s=>s.materials=s.materials.slice()]) {
+        const s=state(),reuse=createSharedAxisElasticReuse();
+        assembleSharedAxisMaterialTangent(s,true,null,true,true,reuse);change(s);
+        assembleSharedAxisMaterialTangent(s,true,null,true,true,reuse);
+        assert.deepEqual(reuse.diagnostics,{elasticFresh:2,elasticReused:0});
+    }
+});
+
+test('native assembly still evaluates current constraint rows and does not publish approximate mechanical caches',()=>{
+    const s=state(),reuse=createSharedAxisElasticReuse();s.cacheMechanicalAssembly=true;
+    assembleSharedAxisNative(s,{elasticReuse:reuse,wasmMaterial:true});
+    move(s);s.multipliers[1]=.2;
+    const chord=assembleSharedAxisNative(s,{elasticReuse:reuse,wasmMaterial:true});
+    const gradient=s.chain.gradient.slice();
+    assert.equal(s.mechanicalAssemblyCache,undefined);
+    const exact=assembleSharedAxisNative(s,{wasmMaterial:true});
+    assert.deepEqual(s.chain.gradient,gradient);
+    assert.equal(chord.energy,exact.energy);assert.equal(chord.force,exact.force);assert.equal(chord.torque,exact.torque);
+    assert.deepEqual(chord.rows,exact.rows);
+    assert.equal(reuse.diagnostics.elasticReused,1);
+});
+
+test('elastic chord solve retains the original force and geometry convergence gates',()=>{
+    const outputs=[];
+    for(const elasticTangentReuse of [false,true]) {
+        const s=createSharedAxisNative({tools:[{id:'wire',insertion:60}]});
+        s.loads[s.layout.positions.at(-1)+1]=.0001;
+        const result=relaxSharedAxisNative(s,{elasticTangentReuse,promoteTrialAssembly:true,wasmMaterial:true});
+        assert.ok(result.converged,JSON.stringify(result));
+        assert.ok(result.residual.force<=1e-6&&result.residual.torque<=1e-6&&result.residual.length<=1e-5);
+        if(elasticTangentReuse)assert.ok(result.elasticFresh>0);
+        outputs.push(s.positions);
+    }
+    assert.ok(Math.max(...outputs[0].map((p,i)=>Math.hypot(...p.map((v,k)=>v-outputs[1][i][k]))))<.001);
+});
+
+test('long-tool eligibility requires both materials to reach the configured insertion',()=>{
+    for(const lengths of [[59,60],[60,59],[60,60]]) {
+        const s=createSharedAxisNative({tools:[{id:'wire',insertion:lengths[0]},{id:'catheter',insertion:lengths[1]}]});
+        const result=relaxSharedAxisNative(s,{elasticTangentReuse:{minimumInsertionMm:60},maxIterations:0});
+        assert.equal((result.elasticFresh??0)>0,lengths.every(n=>n>=60));
+    }
+});
