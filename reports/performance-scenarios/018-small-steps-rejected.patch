+
+
+test('preferred internal half steps preserve atomic publication, accepted dt and tool targets',()=>{
+    const f=fixture({workSliceMs:0,physicsOptions:{preferredSubdivisions:2,substepMinInsertionMm:0}});
+    finish(f);const views=f.tools.map(t=>t.body.jointStateView);
+    f.tools[0].insertion=3;f.tools[1].insertion=1;
+    const result=finish(f,{onPending:()=>f.tools.forEach((t,i)=>assert.equal(t.body.jointStateView,views[i]))});
+    assert.equal(result.dt,dt);assert.equal(f.system.diagnostics.last.subdivisions,2);
+    assert.equal(f.system.diagnostics.last.attempts.length,2);
+    assert.equal(f.system.diagnostics.last.attempts.reduce((sum,a)=>sum+a.dt,0),dt);
+    assert.ok(f.system.diagnostics.last.attempts.every(a=>a.converged));
+    assert.deepEqual(f.tools.map(t=>t.body.jointStateView.coordinates.at(-1)),[3,1]);
+    assert.ok(f.system.diagnostics.last.certificateBound<=1e-6);
+});
+
+test('internal subdivision preference is inactive before both tools reach its threshold',()=>{
+    const a=fixture({workSliceMs:Infinity}),b=fixture({workSliceMs:Infinity,physicsOptions:{preferredSubdivisions:2,substepMinInsertionMm:400}});
+    for(const f of [a,b]){finish(f);f.tools[0].insertion=3;f.tools[1].insertion=1;finish(f);}
+    assert.equal(b.system.diagnostics.last.subdivisions,1);
+    assert.deepEqual(b.tools.map(t=>positions(t.body)),a.tools.map(t=>positions(t.body)));
+});
+
+test('a rejected second half step rolls back before the ordinary whole-step fallback',()=>{
+    const a=fixture({workSliceMs:Infinity}),b=fixture({workSliceMs:Infinity,
+        physicsOptions:{preferredSubdivisions:2,substepMinInsertionMm:0}});
+    for(const f of [a,b])finish(f);
+    b.controls.failQueries=1;
+    for(const f of [a,b]){f.tools[0].insertion=11;finish(f);}
+    const attempts=b.system.diagnostics.last.attempts;
+    assert.equal(attempts[0].subdivisions,2);assert.equal(attempts[0].converged,true);
+    assert.equal(attempts[1].index,2);assert.equal(attempts[1].converged,false);
+    assert.equal(b.system.diagnostics.last.subdivisions,1);
+    assert.deepEqual(b.tools.map(t=>positions(t.body)),a.tools.map(t=>positions(t.body)));
+});
