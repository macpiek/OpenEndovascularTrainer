+
+test('entry prefixes reuse distant length blocks without reordering overlapping active or inactive wall additions',()=>{
+    const layout={dofCount:9,band:4},hessian=new Float64Array(36);
+    for(let i=0;i<9;i++)hessian[i*4]=30+i;
+    const make=(kind,dofs,value)=>({kind,dofs,jacobian:dofs.map((_,k)=>k===0?1:0),gap:kind==='length'?0:-.01,
+        multiplier:.02,geometricHessian:Float64Array.from({length:dofs.length**2},(_,k)=>value*(k+1))});
+    const rows=[make('length',[0,1],.001),make('wall',[1,2],.003),make('length',[1,2,3],.002),
+        make('length',[6,7],.004),make('wall',[6,7],.005),make('length',[0,8],.006),make('length',[5,7,8],.007)];
+    rows[2].jacobian=[0,1,0];rows[4].jacobian=[0,1];rows[5].jacobian=[0,1];
+    const chain={layout,hessian},gradient=new Float64Array(9),fixed=new Uint8Array(9);
+    const context={rows},w=createSharedAxisLinear(layout,rows);
+    assemblePreparedSharedAxisMatrix(w,chain,{rows,gradient,fixed,tolerance:1e-8,activeSet:new Uint8Array(rows.length).fill(1)},context);
+    assert.ok(context.primal.included.has(rows[3]),'a distant complete length block survives an earlier wall');
+    assert.ok(context.primal.partial.has(rows[2]),'only the overlapping entries of a length block are excluded');
+    assert.equal(context.primal.included.has(rows[5]),false,'nonlocal support stays in ordinary assembly');
+    assert.ok(context.primal.partial.has(rows[6]),'nonlocal length rows also block subsequent overlapping entries');
+    for(const compactWorkingSet of [false,true])for(let trial=0;trial<12;trial++) {
+        for(const [index,row] of rows.entries())if(row.kind==='wall') {
+            row.multiplier=(trial+index)%2?.03:0;row.gap=(trial+index)%3?-.01:.02;
+        }
+        // Adjacent entries cancel across the wall/length boundary. Even when
+        // the wall is inactive its Hessian remains in the final suffix.
+        rows[1].geometricHessian[3]=trial%2?1e12:.003;
+        rows[2].geometricHessian[4]=trial%2?-1e12:.002;
+        const outputs=[],matrices=[];
+        for(const reuseMatrixAssembly of [false,true]) {
+            const local=createSharedAxisLinear(layout,rows),trace=[],saved=local.lu.solve,seen=[];
+            local.lu.solve=function(...args){seen.push(args[0].slice());return saved.apply(this,args);};
+            try{outputs.push({...physical(solveSharedAxisLinear(local,chain,{rows,gradient,fixed,compactWorkingSet,reuseMatrixAssembly,trace})),trace});}
+            finally{local.lu.solve=saved;}
+            matrices.push(seen);
+        }
+        assert.deepEqual(outputs[1],outputs[0]);
+        if(!compactWorkingSet){assert.ok(matrices[0].length);assert.deepEqual(matrices[1],matrices[0]);}
+    }
+});
