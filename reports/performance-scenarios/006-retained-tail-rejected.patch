+test('tail retention leaves short searches unchanged and reuses only after repeated contact pivots',()=>{
+    for(const n of [4,32]) {
+        const layout={dofCount:n,band:1},chain={layout,hessian:new Float64Array(n).fill(2)};
+        const rows=Array.from({length:n},(_,i)=>({id:i,kind:'wall',dofs:[i],jacobian:[1],gap:-1-i/10,multiplier:0}));
+        const options={rows,gradient:new Float64Array(n),fixed:new Uint8Array(n),batchActivation:false,wasmLinearAssembly:true};
+        const reference=solveSharedAxisLinear(createSharedAxisLinear(layout,rows,{lazy:true}),chain,options);
+        const actual=solveSharedAxisLinear(createSharedAxisLinear(layout,rows,{lazy:true}),chain,{...options,incrementalContacts:'tail'});
+        assert.ok(actual.converged);assert.equal(actual.activeSetAttempts,reference.activeSetAttempts);
+        if(n<8)assert.equal(actual.factorizations,reference.factorizations);
+        else assert.ok(actual.factorizations<reference.factorizations);
+        for(const key of ['increment','multiplierIncrement'])for(let i=0;i<actual[key].length;i++)
+            assert.ok(Math.abs(actual[key][i]-reference[key][i])<1e-10);
+    }
