+// Explicit research gate for PD with exact geometric closure. This does not
+// certify Newton equilibrium or replace the unchanged reference force gate.
+export const CROSSOVER_PD_QUALITY_MODEL='projective-geometry';
+export const CROSSOVER_NEWTON_QUALITY_MODEL='newton-equilibrium';
+const bounded=(value,limit)=>Number.isFinite(value)&&value>=0&&value<=limit;
+export function crossoverProjectiveGate(dt,result) {
+    const pd=result?.pd,q=result?.quality,parameters=pd?.parameters;
+    return dt===1/60&&result?.converged===true&&q?.finite===true&&
+        pd?.model==='projective-with-hard-kirchhoff-closure'&&pd.equilibriumCertified===false&&
+        parameters?.hardClosure===true&&['maxLengthError','maxPenetration','maxShear'].every(k=>
+            Number.isFinite(parameters[k])&&parameters[k]>0&&parameters[k]<=1e-5)&&
+        bounded(pd.maxLengthError,parameters.maxLengthError)&&bounded(pd.maxLengthErrorMm,parameters.maxLengthError)&&
+        bounded(pd.maxShear,parameters.maxShear)&&bounded(q.maxPenetration,parameters.maxPenetration)&&
+        bounded(pd.change,Number.MAX_VALUE)&&Array.isArray(q.bodies)&&q.bodies.length>0&&q.bodies.every(b=>
+            bounded(b.maxLengthError,parameters.maxLengthError)&&bounded(b.maxBendAngleDegrees,180)&&
+            (b.maxBendLimitDegrees===null||(bounded(b.maxBendLimitDegrees,180)&&b.maxBendAngleDegrees<=b.maxBendLimitDegrees+1e-5)));
+}
