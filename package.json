{
  "name": "openendovasculartrainer",
  "version": "1.0.0",
  "description": "Browser-based endovascular trainer with an extended arterial tree, coupled direct discrete Kirchhoff rods, unilateral vessel and lumen contact, and fluoroscopic imaging.",
  "main": "src/simulator.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "docs:generate": "node scripts/generate-code-docs.mjs",
    "docs:check": "node scripts/generate-code-docs.mjs --check",
    "collision:build": "node scripts/build-collision-asset.mjs",
    "benchmark:collision": "node --expose-gc scripts/collision-benchmark.mjs",
    "benchmark:kirchhoff": "node scripts/kirchhoff-runtime-benchmark.mjs",
    "benchmark:browser:chrome": "node scripts/run-browser-acceptance.mjs",
    "benchmark:browser:safari": "node scripts/run-safari-acceptance.mjs",
    "centerline:diagnostics": "node scripts/centerline-diagnostics.mjs",
    "test:contrast": "node --test tests/contrastAnatomicalVolume.test.js tests/contrastContinuousTransport.test.js tests/contrastOstialReservoir.test.js tests/contrastOstialVolume.test.js tests/contrastDilatedLumen.test.js && node tests/contrastHybridModel.test.js && node tests/contrastFullTree.test.js && node tests/contrastCatheterFullTree.test.js",
    "test:contrast:visual": "node scripts/render-contrast-bifurcation-regression.mjs",
    "test:imaging": "node tests/dsaRoadmapState.test.js && node tests/detectorZoomModes.test.js && node tests/xrayDoseRate.test.js && node --test tests/dsaSimulationTiming.test.js && node --test tests/carmControls.test.js tests/carmPose.test.js tests/renderMetalProjection.test.js",
    "preview": "vite preview",
    "video:studio": "remotion studio video/index.ts",
    "video:render": "remotion render video/index.ts EndovascularTrainerAd out/endovascular-trainer-ad.mp4 --codec=h264 --overwrite",
    "video:still": "remotion still video/index.ts EndovascularTrainerAd out/endovascular-trainer-frame.png --frame=210 --overwrite",
    "test": "node scripts/run-tests.mjs default",
    "test:physics:optimization": "node tests/kirchhoffContactBlock.test.js && node tests/kirchhoffCenterlineSearch.test.js && node tests/kirchhoffDirectOptimization.test.js && node tests/kirchhoffCoupledConvergence.test.js && node tests/shortCatheterBenchmark.test.js",
    "test:guidewire:mechanics": "node tests/kirchhoffDirectSolver.test.js",
    "test:catheter:mechanics": "node tests/kirchhoffDirectCoupling.test.js && node tests/kirchhoffCatheterOverWireRegression.test.js",
    "test:memory": "node tests/runtimeMemoryLifetime.test.js && node tests/skeletonGeometry.test.js",
    "test:physics:coupled": "node scripts/run-tests.mjs physics:coupled",
    "test:physics:composite": "node scripts/run-tests.mjs physics:composite",
    "anatomy:rebuild": "node --max-old-space-size=8192 scripts/extend-lower-limb-arteries.mjs",
    "anatomy:extend-lower-limbs": "node --max-old-space-size=8192 scripts/extend-lower-limb-arteries.mjs",
    "test:anatomy": "node tests/lowerLimbPathDefinitions.test.js && node tests/upperLimbPathDefinitions.test.js && node tests/headArteryPathDefinitions.test.js && node tests/lowerLimbArteries.test.js && node tests/upperLimbArteries.test.js && node tests/headArteries.test.js && node --test tests/subclavianAlignment.test.js",
    "test:physics:shared-axis": "node scripts/run-tests.mjs physics:shared-axis",
    "test:physics:shared-axis:anatomy": "node --test tests/kirchhoffSharedAxisAnatomyRegression.test.js",
    "test:anatomy:closures": "node --test tests/aortaOutletClosures.test.js tests/kirchhoffSharedAxisSegmentContact.test.js tests/kirchhoffSharedAxisSegmentCache.test.js tests/kirchhoffSharedAxisClosedRootFallback.test.js",
    "anatomy:align-subclavians": "node --max-old-space-size=8192 scripts/align-subclavian-arteries.mjs",
    "anatomy:aneurysm": "node scripts/rebuild-infrarenal-aneurysm.mjs",
    "test:anatomy:aneurysm": "node --test tests/anatomyControls.test.js tests/infrarenalAneurysm.test.js tests/aneurysmRebuild.test.js",
    "test:stentgraft": "node scripts/run-tests.mjs stentgraft",
    "test:anatomy:mesh": "node --test tests/vesselMeshIntegrity.test.js tests/aortaOutletClosures.test.js tests/subclavianAlignment.test.js tests/infrarenalAneurysm.test.js",
    "benchmark:continuous-contacts": "node scripts/benchmark-continuous-contacts.mjs",
    "test:contrast:graft": "node --test tests/contrastGraftFlow.test.js tests/contrastGraftAnatomy.test.js tests/contrastPartialGraft.test.js tests/contrastSacWashout.test.js",
    "benchmark:contrast": "node scripts/benchmark-contrast.mjs",
    "benchmark:stentgraft": "node scripts/benchmark-stent-graft.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@remotion/cli": "^4.0.476",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.476",
    "three": "^0.160.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.9.1"
  },
  "devDependencies": {
    "vite": "^7.1.12",
    "manifold-3d": "^3.5.1"
  }
}
